# Copy to keystore.properties (gitignored) and fill in to sign release builds.
# Generate a keystore:
#   keytool -genkey -v -keystore release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias acefuel
storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=acefuel
keyPassword=CHANGE_ME
# Production API base URL baked into the release build (must end with /).
apiBaseUrl=https://fly.thoughtbasics.com/
