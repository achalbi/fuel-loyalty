<% content_for :title, "Capture Visit" %>
<div class="row justify-content-center">
  <div class="col-md-9 col-lg-8">
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h1 class="h3 mb-0">Capture Visit</h1>
          <%= link_to "Today's captures", staff_visit_entries_path, class: "btn btn-outline-secondary btn-sm" %>
        </div>
        <p class="text-muted">Record a fuelling — litres, driver, discount and Fleet/OTP status. The ₹ value is settled later from the catalog price.</p>
        <%= render "form", visit_entry: @visit_entry, fuel_pumps: @fuel_pumps, fuel_type_options: @fuel_type_options %>
      </div>
    </div>
  </div>
</div>
