<%= form_with model: visit_entry, url: staff_visit_entries_path, method: :post, class: "vstack gap-3" do |form| %>
  <% if visit_entry.errors.any? %>
    <div class="alert alert-danger"><%= visit_entry.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="row g-3">
    <div class="col-sm-8">
      <%= form.label :vehicle_number, "Vehicle Number", class: "form-label" %>
      <%= form.text_field :vehicle_number, class: "form-control", required: true, autocapitalize: "characters", placeholder: "KA01AB1234" %>
      <div class="form-text">A registered plate auto-links the customer and their contacts.</div>
    </div>
    <div class="col-sm-4">
      <%= form.label :entry_date, "Date", class: "form-label" %>
      <%= form.date_field :entry_date, class: "form-control", value: (visit_entry.entry_date || Date.current) %>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-sm-6">
      <%= form.label :litres, "Litres", class: "form-label" %>
      <%= form.number_field :litres, step: "0.001", min: "0", class: "form-control", required: true, inputmode: "decimal", placeholder: "e.g. 136.000" %>
    </div>
    <div class="col-sm-6">
      <%= form.label :fuel_type_code, "Fuel", class: "form-label" %>
      <%= form.select :fuel_type_code, options_for_select(fuel_type_options, visit_entry.fuel_type_code), { include_blank: "—" }, class: "form-select" %>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-sm-6">
      <%= form.label :fuel_pump_id, "Pump", class: "form-label" %>
      <%= form.select :fuel_pump_id, options_for_select(fuel_pumps.map { |pump| [pump.display_name, pump.id] }, visit_entry.fuel_pump_id), { include_blank: "My Pump (default)" }, class: "form-select" %>
      <div class="form-text">Defaults to your assigned pump; override for a cross-pump capture.</div>
    </div>
    <div class="col-sm-6">
      <%= form.label :discount_amount, "Discount (₹)", class: "form-label" %>
      <%= form.number_field :discount_amount, step: "0.01", min: "0", class: "form-control", inputmode: "decimal", placeholder: "0" %>
      <div class="form-text">The ₹ discount promised at the pump; flows to the daily settlement.</div>
    </div>
  </div>

  <div class="form-check form-switch">
    <%= form.check_box :fleet_otp, class: "form-check-input", role: "switch" %>
    <%= form.label :fleet_otp, "Fleet / OTP visit", class: "form-check-label" %>
  </div>

  <fieldset class="border rounded p-3">
    <legend class="form-label float-none w-auto px-1 mb-0">Driver</legend>
    <div class="row g-3">
      <div class="col-sm-7">
        <%= form.label :driver_name, "Name", class: "form-label small mb-1" %>
        <%= form.text_field :driver_name, class: "form-control", placeholder: "Optional" %>
      </div>
      <div class="col-sm-5">
        <%= form.label :driver_phone_number, "Mobile", class: "form-label small mb-1" %>
        <%= form.telephone_field :driver_phone_number, class: "form-control", inputmode: "numeric", maxlength: 10, placeholder: "Optional" %>
      </div>
    </div>
  </fieldset>

  <fieldset class="border rounded p-3">
    <legend class="form-label float-none w-auto px-1 mb-0">Fleet / Transport <span class="text-muted small">(OTP)</span></legend>
    <div class="row g-3">
      <div class="col-sm-8">
        <%= form.label :transport_name, "Transport name", class: "form-label small mb-1" %>
        <%= form.text_field :transport_name, class: "form-control", placeholder: "Optional" %>
      </div>
      <div class="col-sm-4">
        <%= form.label :approx_vehicle_count, "Approx vehicles", class: "form-label small mb-1" %>
        <%= form.number_field :approx_vehicle_count, min: 0, class: "form-control", placeholder: "Optional" %>
      </div>
      <div class="col-sm-7">
        <%= form.label :manager_name, "Manager name", class: "form-label small mb-1" %>
        <%= form.text_field :manager_name, class: "form-control", placeholder: "Optional" %>
      </div>
      <div class="col-sm-5">
        <%= form.label :manager_phone_number, "Manager mobile", class: "form-label small mb-1" %>
        <%= form.telephone_field :manager_phone_number, class: "form-control", inputmode: "numeric", maxlength: 10, placeholder: "Optional" %>
      </div>
      <div class="col-sm-7">
        <%= form.label :owner_name, "Owner name", class: "form-label small mb-1" %>
        <%= form.text_field :owner_name, class: "form-control", placeholder: "Optional" %>
      </div>
      <div class="col-sm-5">
        <%= form.label :owner_phone_number, "Owner mobile", class: "form-label small mb-1" %>
        <%= form.telephone_field :owner_phone_number, class: "form-control", inputmode: "numeric", maxlength: 10, placeholder: "Optional" %>
      </div>
    </div>
  </fieldset>

  <div class="d-flex gap-2">
    <%= form.submit "Capture Visit", class: "btn btn-primary" %>
    <%= link_to "Cancel", staff_visit_entries_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
