<% content_for :title, "Visit Captures" %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3 mb-1">Visit Captures</h1>
    <p class="text-muted mb-0"><%= @fuel_pump&.display_name || "No pump assigned" %> · <%= @entry_date.strftime("%d %b %Y") %></p>
  </div>
  <%# Item 2 — capture happens on the merged New Entry screen. %>
  <%= link_to "New Entry", new_staff_transaction_path, class: "btn btn-primary" %>
</div>

<%= form_with url: staff_visit_entries_path, method: :get, class: "row g-2 align-items-end mb-3" do |f| %>
  <div class="col-auto">
    <%= f.label :date, "Date", class: "form-label" %>
    <%= f.date_field :date, value: @entry_date, class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= f.label :fuel_pump_id, "Pump", class: "form-label" %>
    <%= f.select :fuel_pump_id, options_for_select(@fuel_pumps.map { |pump| [pump.display_name, pump.id] }, @fuel_pump&.id), { include_blank: "—" }, class: "form-select" %>
  </div>
  <div class="col-auto"><%= f.submit "Show", class: "btn btn-outline-secondary" %></div>
<% end %>

<% if @visit_entries.any? %>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th>Vehicle</th><th>Customer</th><th class="text-end">Litres</th>
          <th class="text-end">Discount</th><th>Driver</th><th>Fleet/OTP</th><th>Time</th>
        </tr>
      </thead>
      <tbody>
        <% @visit_entries.each do |entry| %>
          <tr>
            <td><strong><%= entry.vehicle_number %></strong></td>
            <td><%= entry.customer&.display_name || "—" %></td>
            <td class="text-end"><%= entry.litres.to_s %></td>
            <td class="text-end"><%= number_to_currency(entry.discount_amount, unit: "₹") %></td>
            <td><%= entry.driver_name.presence || "—" %></td>
            <td><%= entry.fleet_otp? ? "Yes" : "No" %></td>
            <td><%= entry.created_at.strftime("%H:%M") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="card"><div class="card-body text-muted mb-0">No visits captured for this pump and date.</div></div>
<% end %>
