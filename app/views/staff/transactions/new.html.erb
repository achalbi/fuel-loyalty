<% content_for :title, "New Transaction" %>
<% content_for :head do %>
  <%= javascript_include_tag "vehicle_plate_scanner", "data-turbo-track": "reload", defer: true %>
<% end %>
<% active_lookup_mode = @active_lookup_mode.presence_in(%w[phone vehicle]) || "vehicle" %>
<% phone_tab_active = active_lookup_mode == "phone" %>
<% vehicle_tab_active = active_lookup_mode == "vehicle" %>
<% registration_customer = @registration_customer || Customer.new %>

<div class="card shadow-sm mb-2 transaction-entry-shell">
  <div class="card-body">
    <div class="transaction-entry-titlebar">
      <div class="transaction-entry-titlebar__heading">
        <h1 class="h3 mb-0">Record Fuel Transaction</h1>
        <button
          type="button"
          class="transaction-entry-titlebar__hint-toggle"
          data-bs-toggle="collapse"
          data-bs-target="#transactionEntryHeadingHint"
          aria-expanded="false"
          aria-controls="transactionEntryHeadingHint"
          aria-label="Show transaction help"
          title="Show transaction help">
          <i class="ti ti-info-circle" aria-hidden="true"></i>
        </button>
      </div>

      <div class="collapse transaction-entry-titlebar__hint" id="transactionEntryHeadingHint">
        <div class="transaction-entry-titlebar__hint-card">
          <p class="mb-0 transaction-entry-tabs__description-text" data-lookup-tab-description-target>
            <%= vehicle_tab_active ? "Match the vehicle plate to the right customer profile." : "Find the customer first, then choose a vehicle." %>
          </p>
        </div>
      </div>
    </div>

    <ul class="nav nav-pills transaction-entry-tabs" id="transactionEntryTabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button
          class="nav-link <%= "active" if phone_tab_active %>"
          id="transaction-phone-tab"
          data-bs-toggle="tab"
          data-bs-target="#transaction-phone-pane"
          data-lookup-tab-focus-target="phone"
          data-lookup-tab-description="Find the customer first, then choose a vehicle."
          type="button"
          role="tab"
          aria-controls="transaction-phone-pane"
          aria-selected="<%= phone_tab_active %>">
          <span class="transaction-entry-tabs__header">
            <span class="transaction-entry-tabs__icon" aria-hidden="true">
              <i class="ti ti-device-mobile"></i>
            </span>
            <span class="transaction-entry-tabs__title">Phone Number</span>
          </span>
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button
          class="nav-link <%= "active" if vehicle_tab_active %>"
          id="transaction-vehicle-tab"
          data-bs-toggle="tab"
          data-bs-target="#transaction-vehicle-pane"
          data-lookup-tab-focus-target="vehicle"
          data-lookup-tab-description="Match the vehicle plate to the right customer profile."
          type="button"
          role="tab"
          aria-controls="transaction-vehicle-pane"
          aria-selected="<%= vehicle_tab_active %>">
          <span class="transaction-entry-tabs__header">
            <span class="transaction-entry-tabs__icon" aria-hidden="true">
              <i class="ti ti-car"></i>
            </span>
            <span class="transaction-entry-tabs__title">Vehicle Number</span>
          </span>
        </button>
      </li>
    </ul>
    <% if @errors.present? %>
      <div class="alert alert-danger transaction-entry-page-error" role="alert">
        <div>
          <strong>Transaction could not be saved.</strong>
          <span>Review the highlighted step in the transaction modal and try again.</span>
        </div>
        <button
          type="button"
          class="btn btn-outline-danger btn-sm"
          data-bs-toggle="modal"
          data-bs-target="#transactionEntryWizardModal">
          Review Steps
        </button>
      </div>
    <% end %>
    <div class="<%= "d-none" unless phone_tab_active %>" data-transaction-page-stepper="phone">
      <div class="transaction-entry-stepper" data-transaction-stepper>
        <button type="button" class="transaction-entry-step" data-transaction-step-marker="lookup" data-transaction-step-target="lookup">
          <span class="transaction-entry-step__eyebrow">
            <span class="transaction-entry-step__count">1</span>
            <span class="transaction-entry-step__status" data-transaction-step-status>Current</span>
          </span>
          <strong class="transaction-entry-step__title">Find Customer</strong>
          <span class="transaction-entry-step__text">Enter the phone number and load the profile.</span>
        </button>
        <button type="button" class="transaction-entry-step" data-transaction-step-marker="review" data-transaction-step-target="review">
          <span class="transaction-entry-step__eyebrow">
            <span class="transaction-entry-step__count">2</span>
            <span class="transaction-entry-step__status" data-transaction-step-status>Locked</span>
          </span>
          <strong class="transaction-entry-step__title">Review Vehicle</strong>
          <span class="transaction-entry-step__text">Confirm the customer card and pick the correct vehicle.</span>
        </button>
        <button type="button" class="transaction-entry-step" data-transaction-step-marker="fuel" data-transaction-step-target="fuel">
          <span class="transaction-entry-step__eyebrow">
            <span class="transaction-entry-step__count">3</span>
            <span class="transaction-entry-step__status" data-transaction-step-status>Locked</span>
          </span>
          <strong class="transaction-entry-step__title">Fuel Details</strong>
          <span class="transaction-entry-step__text">Enter the amount, choose nozzle, and save.</span>
        </button>
      </div>
    </div>
    <div class="<%= "d-none" unless vehicle_tab_active %>" data-transaction-page-stepper="vehicle">
      <div class="transaction-entry-stepper" data-transaction-stepper>
        <button type="button" class="transaction-entry-step" data-transaction-step-marker="lookup" data-transaction-step-target="lookup">
          <span class="transaction-entry-step__eyebrow">
            <span class="transaction-entry-step__count">1</span>
            <span class="transaction-entry-step__status" data-transaction-step-status>Current</span>
          </span>
          <strong class="transaction-entry-step__title">Find Vehicle</strong>
          <span class="transaction-entry-step__text">Scan or enter the vehicle number to find the customer.</span>
        </button>
        <button type="button" class="transaction-entry-step" data-transaction-step-marker="review" data-transaction-step-target="review">
          <span class="transaction-entry-step__eyebrow">
            <span class="transaction-entry-step__count">2</span>
            <span class="transaction-entry-step__status" data-transaction-step-status>Locked</span>
          </span>
          <strong class="transaction-entry-step__title">Confirm Match</strong>
          <span class="transaction-entry-step__text">Check the matched profile before recording fuel.</span>
        </button>
        <button type="button" class="transaction-entry-step" data-transaction-step-marker="fuel" data-transaction-step-target="fuel">
          <span class="transaction-entry-step__eyebrow">
            <span class="transaction-entry-step__count">3</span>
            <span class="transaction-entry-step__status" data-transaction-step-status>Locked</span>
          </span>
          <strong class="transaction-entry-step__title">Fuel Details</strong>
          <span class="transaction-entry-step__text">Enter amount, choose nozzle, and save the sale.</span>
        </button>
      </div>
    </div>
    <div class="transaction-entry-launch-actions">
      <p class="mb-0 transaction-entry-tabs__description-text">
        Continue the selected lookup flow in the step-by-step wizard modal.
      </p>
      <button
        type="button"
        class="btn btn-primary"
        data-bs-toggle="modal"
        data-bs-target="#transactionEntryWizardModal">
        Open Steps
      </button>
    </div>
  </div>
</div>

<div
  class="modal fade transaction-entry-modal"
  id="transactionEntryWizardModal"
  tabindex="-1"
  aria-labelledby="transactionEntryWizardModalLabel"
  aria-hidden="true"
  data-transaction-entry-modal
  data-auto-open-modal="<%= ((vehicle_tab_active && @auto_open_plate_scanner) || @errors.present?).to_s %>">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl modal-fullscreen-md-down transaction-entry-modal__dialog">
    <div class="modal-content transaction-entry-modal__content">
      <div class="modal-header border-0 pb-0 transaction-entry-modal__header">
        <div>
          <h2 class="modal-title h4 mb-1" id="transactionEntryWizardModalLabel">Transaction Steps</h2>
          <p class="text-muted mb-0 small">Complete one step at a time for the currently selected lookup mode.</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body pt-3 transaction-entry-modal__body">

<div class="tab-content transaction-entry-content">
  <div
    class="tab-pane fade <%= "show active" if phone_tab_active %>"
    id="transaction-phone-pane"
    role="tabpanel"
    aria-labelledby="transaction-phone-tab"
    tabindex="0">
    <div
      class="transaction-entry-panel"
      data-transaction-phone-root
      data-transaction-wizard-key="phone"
      data-lookup-url="<%= lookup_staff_customers_path %>"
      data-transaction-error-step="<%= @active_lookup_mode == "phone" ? @transaction_error_step : "" %>"
      data-selected-vehicle-id="<%= phone_tab_active ? @prefill_vehicle_id : "" %>">
      <div class="alert alert-warning d-none mb-0 transaction-customer-error" data-customer-error role="alert"></div>

      <%= form_with scope: :transaction, namespace: :phone_transaction, url: staff_transactions_path, class: "transaction-entry-wizard-form" do |form| %>
        <%= form.hidden_field :lookup_mode, value: "phone" %>

        <div class="transaction-entry-step-modal">
          <section class="card shadow-sm transaction-entry-step-card" data-transaction-step-section="lookup">
            <div class="card-body">
              <div class="transaction-entry-step-card__header">
                <div class="transaction-entry-step-card__title-stack">
                  <div class="transaction-entry-step-card__eyebrow">Step 1</div>
                  <div class="transaction-entry-step-card__title-row">
                    <h2 class="h4 mb-0">Lookup by Phone</h2>
                    <button
                      type="button"
                      class="transaction-entry-titlebar__hint-toggle"
                      data-bs-toggle="collapse"
                      data-bs-target="#transactionPhoneLookupHint"
                      aria-expanded="false"
                      aria-controls="transactionPhoneLookupHint"
                      aria-label="Show phone lookup help"
                      title="Show phone lookup help">
                      <i class="ti ti-info-circle" aria-hidden="true"></i>
                    </button>
                  </div>
                  <p class="transaction-entry-step-card__summary mb-0">Find the customer first, then move to a focused review step.</p>
                </div>
              </div>

              <div class="collapse transaction-entry-titlebar__hint" id="transactionPhoneLookupHint">
                <div class="transaction-entry-titlebar__hint-card">
                  Enter the customer's phone number to load the profile. Customer must already exist. Use the customer screen to register a new customer or add more vehicles.
                </div>
              </div>

              <% if phone_tab_active && @errors.present? && @transaction_error_step == "lookup" %>
                <div class="alert alert-danger" data-transaction-server-error><%= @errors.to_sentence %></div>
              <% end %>

              <div class="transaction-entry-step-card__body">
                <div>
                  <%= form.label :phone_number, class: "form-label" %>
                  <div class="input-group">
                    <span class="input-group-text phone-prefix transaction-entry-lookup-prefix">+91</span>
                    <%= form.telephone_field :phone_number,
                      value: phone_tab_active ? @prefill_phone_number : nil,
                      class: "form-control transaction-entry-lookup-input",
                      required: true,
                      placeholder: "10 digit phone no.",
                      inputmode: "numeric",
                      autocomplete: "off",
                      maxlength: 10,
                      pattern: "\\d{10}",
                      title: "Enter a 10 digit phone number",
                      data: { phone_input: true, phone_number_field: true, lookup_focus_input: "phone" } %>
                  </div>
                </div>
              </div>

              <div class="transaction-entry-step-card__footer">
                <p class="transaction-entry-step-card__footer-note mb-0">Lookup completes when a customer profile is found.</p>
                <div class="transaction-entry-step-card__actions">
                  <button type="button" class="btn btn-primary" data-transaction-step-next="review" data-transaction-step-next-gate="lookup" disabled>Continue to Review</button>
                </div>
              </div>
            </div>
          </section>

          <section class="card shadow-sm loyalty-result-card redemption-customer-shell transaction-customer-shell transaction-entry-step-card" data-transaction-step-section="review" hidden>
            <div class="card-body">
              <div class="transaction-entry-step-card__header redemption-customer-shell__header">
                <div>
                  <div class="transaction-entry-step-card__eyebrow">Step 2</div>
                  <h2 class="h5 mb-1">Customer Details</h2>
                  <p class="text-muted mb-0">Review the profile and choose the right vehicle before recording fuel.</p>
                </div>
              </div>

              <div class="transaction-entry-step-card__body">
                <% if phone_tab_active && @errors.present? && @transaction_error_step == "review" %>
                  <div class="alert alert-danger" data-transaction-server-error><%= @errors.to_sentence %></div>
                <% end %>

                <div>
                  <%= form.label :vehicle_id, "Vehicle", class: "form-label" %>
                  <%= form.select :vehicle_id, [], { prompt: "Select a vehicle" }, class: "form-select", required: true, disabled: true, data: { vehicle_select: true } %>
                </div>

                <div class="redemption-customer-card redemption-customer-card--placeholder" data-customer-placeholder>
                  <div class="redemption-customer-card__placeholder-icon" aria-hidden="true">
                    <i class="ti ti-search"></i>
                  </div>
                  <p class="text-muted mb-0">Search by phone number to view the customer profile and available vehicles.</p>
                </div>

                <div class="d-none redemption-customer-card transaction-customer-card" data-customer-panel>
                  <div class="redemption-customer-card__hero">
                    <span class="small-muted redemption-customer-card__eyebrow">Available Points</span>
                    <strong class="redemption-customer-card__value" data-customer-points></strong>
                    <span class="redemption-customer-card__note is-pending" data-customer-note></span>
                  </div>

                  <div class="redemption-customer-card__identity">
                    <div class="redemption-customer-card__identity-heading">
                      <h3 class="redemption-customer-card__name mb-0" data-customer-name></h3>
                      <span class="redemption-customer-card__status" data-customer-status></span>
                    </div>
                    <p class="redemption-customer-card__phone mb-0" data-customer-phone></p>
                  </div>

                  <div class="redemption-customer-card__stats transaction-customer-card__stats">
                    <div class="redemption-customer-card__stat">
                      <span class="redemption-customer-card__stat-label">Vehicles on File</span>
                      <strong class="redemption-customer-card__stat-value" data-customer-vehicles-count></strong>
                    </div>
                    <div class="redemption-customer-card__stat">
                      <span class="redemption-customer-card__stat-label">Selected Vehicle</span>
                      <strong class="redemption-customer-card__stat-value transaction-customer-card__stat-value" data-customer-selected-vehicle></strong>
                    </div>
                  </div>

                  <div class="transaction-customer-card__vehicles">
                    <div class="transaction-customer-card__vehicles-header">
                      <div>
                        <h3 class="h6 mb-1">Registered Vehicles</h3>
                        <p class="small-muted mb-0">Tap a vehicle here or choose it from the selector above.</p>
                      </div>
                    </div>

                    <div class="customer-details-vehicle-list transaction-customer-card__vehicle-list" data-customer-vehicles-list></div>
                  </div>
                </div>
              </div>

              <div class="transaction-entry-step-card__footer">
                <div class="transaction-entry-step-card__actions">
                  <button type="button" class="btn btn-outline-secondary" data-transaction-step-prev="lookup">Back</button>
                </div>
                <div class="transaction-entry-step-card__actions">
                  <button type="button" class="btn btn-primary" data-transaction-step-next="fuel" data-transaction-step-next-gate="review" data-transaction-step-focus-target="fuel-amount" disabled>Continue to Fuel</button>
                </div>
              </div>
            </div>
          </section>

          <section class="card shadow-sm transaction-entry-step-card" data-transaction-step-section="fuel" hidden>
            <div class="card-body">
              <div class="transaction-entry-step-card__header">
                <div>
                  <div class="transaction-entry-step-card__eyebrow">Step 3</div>
                  <h2 class="h4 mb-1">Fuel Details</h2>
                  <p class="transaction-entry-step-card__summary mb-0">Enter the sale amount, choose the compatible nozzle, and save the transaction.</p>
                </div>
              </div>

              <fieldset class="transaction-entry-step-card__fieldset" data-transaction-step-fieldset="fuel" disabled>
                <div class="transaction-entry-step-card__body">
                  <% if phone_tab_active && @errors.present? && @transaction_error_step == "fuel" %>
                    <div class="alert alert-danger" data-transaction-server-error><%= @errors.to_sentence %></div>
                  <% end %>

                  <div>
                    <%= form.label :fuel_amount, "Fuel Amount (₹)", class: "form-label" %>
                    <%= form.number_field :fuel_amount, value: phone_tab_active ? @prefill_fuel_amount : nil, class: "form-control", step: "0.01", min: 1, required: true, data: { transaction_step_focus: "fuel-amount" } %>
                  </div>

                  <%= render "pump_selection_fields",
                    form: form,
                    transaction_fuel_pump: @transaction_fuel_pump,
                    transaction_fuel_pump_nozzles: @transaction_fuel_pump_nozzles,
                    selected_nozzle_id: @prefill_fuel_pump_nozzle_id,
                    dom_prefix: "phone_transaction" %>
                </div>
              </fieldset>

              <div class="transaction-entry-step-card__footer">
                <div class="transaction-entry-step-card__actions">
                  <button type="button" class="btn btn-outline-secondary" data-transaction-step-prev="review">Back</button>
                </div>
                <div class="transaction-entry-step-card__actions">
                  <%= form.submit "Save Transaction", class: "btn btn-primary", disabled: true, data: { submit_button: true } %>
                </div>
              </div>
            </div>
          </section>
        </div>
      <% end %>
    </div>
  </div>

  <div
    class="tab-pane fade <%= "show active" if vehicle_tab_active %>"
    id="transaction-vehicle-pane"
    role="tabpanel"
    aria-labelledby="transaction-vehicle-tab"
    tabindex="0">
    <div
      class="transaction-entry-panel"
      data-transaction-vehicle-root
      data-transaction-wizard-key="vehicle"
      data-lookup-url="<%= lookup_staff_transactions_path %>"
      data-transaction-error-step="<%= @active_lookup_mode == "vehicle" ? @transaction_error_step : "" %>"
      data-selected-vehicle-id="<%= vehicle_tab_active ? @prefill_vehicle_id : "" %>">
      <div class="alert alert-warning d-none mb-0 transaction-customer-error" data-customer-error role="alert"></div>

      <%= form_with scope: :transaction, namespace: :vehicle_transaction, url: staff_transactions_path, class: "transaction-entry-wizard-form" do |form| %>
        <%= form.hidden_field :lookup_mode, value: "vehicle" %>

        <div class="transaction-entry-step-modal">
          <section class="card shadow-sm transaction-entry-step-card" data-transaction-step-section="lookup">
            <div class="card-body">
              <div class="transaction-entry-step-card__header transaction-entry-step-card__header--with-toggle">
                <div class="transaction-entry-step-card__title-stack">
                  <div class="transaction-entry-step-card__eyebrow">Step 1</div>
                  <div class="transaction-entry-step-card__title-row">
                    <h2 class="h4 mb-0">Lookup by Vehicle</h2>
                    <button
                      type="button"
                      class="transaction-entry-titlebar__hint-toggle"
                      data-bs-toggle="collapse"
                      data-bs-target="#transactionVehicleLookupHint"
                      aria-expanded="false"
                      aria-controls="transactionVehicleLookupHint"
                      aria-label="Show vehicle lookup help"
                      title="Show vehicle lookup help">
                      <i class="ti ti-info-circle" aria-hidden="true"></i>
                    </button>
                  </div>
                </div>
                <button
                  type="button"
                  class="btn btn-light btn-icon btn-sm transaction-entry-step-card__camera-toggle"
                  data-topbar-plate-scanner-toggle
                  aria-label="Scan Vehicle Plate"
                  title="Scan Vehicle Plate">
                  <i class="ti ti-camera" aria-hidden="true"></i>
                </button>
              </div>

              <div class="collapse transaction-entry-titlebar__hint" id="transactionVehicleLookupHint">
                <div class="transaction-entry-titlebar__hint-card">
                  Scan or enter the vehicle number to find the customer. If multiple customers share the same vehicle number, choose the correct profile in the next step.
                </div>
              </div>

              <% if vehicle_tab_active && @errors.present? && @transaction_error_step == "lookup" %>
                <div class="alert alert-danger" data-transaction-server-error><%= @errors.to_sentence %></div>
              <% end %>

              <div class="transaction-entry-step-card__body">
                <%= render "vehicle_plate_field",
                  form: form,
                  prefill_vehicle_number: @prefill_vehicle_number,
                  vehicle_tab_active: vehicle_tab_active,
                  auto_open: @auto_open_plate_scanner && vehicle_tab_active %>
              </div>

              <div class="transaction-entry-step-card__footer">
                <p class="transaction-entry-step-card__footer-note mb-0">Continue once a matching customer is found.</p>
                <div class="transaction-entry-step-card__actions">
                  <button type="button" class="btn btn-primary" data-transaction-step-next="review" data-transaction-step-next-gate="lookup" disabled>Continue to Review</button>
                </div>
              </div>
            </div>
          </section>

          <section class="card shadow-sm loyalty-result-card redemption-customer-shell transaction-customer-shell transaction-entry-step-card" data-transaction-step-section="review" hidden>
            <div class="card-body">
              <div class="transaction-entry-step-card__header transaction-entry-step-card__header--with-action redemption-customer-shell__header">
                <div class="transaction-entry-step-card__title-stack">
                  <div class="transaction-entry-step-card__eyebrow">Step 2</div>
                  <h2 class="h5 mb-0">Matched Customer</h2>
                </div>
                <div class="transaction-entry-step-card__header-actions">
                  <button
                    type="button"
                    class="btn btn-icon btn-sm transaction-entry-step-card__header-action transaction-entry-step-card__header-action--positive"
                    data-transaction-register-customer-trigger
                    aria-label="Add Customer"
                    title="Add Customer">
                    <i class="ti ti-user-plus" aria-hidden="true"></i>
                  </button>
                </div>
                <p class="transaction-entry-step-card__summary mb-0">Confirm the matched profile and vehicle before recording this transaction.</p>
              </div>

              <div class="transaction-entry-step-card__body">
                <% if vehicle_tab_active && @errors.present? && @transaction_error_step == "review" %>
                  <div class="alert alert-danger" data-transaction-server-error><%= @errors.to_sentence %></div>
                <% end %>

                <div>
                  <%= form.label :vehicle_id, "Matching Customer", class: "form-label" %>
                  <%= form.select :vehicle_id, [], { prompt: "Select the matching customer" }, class: "form-select", required: true, disabled: true, data: { vehicle_select: true } %>
                </div>

                <div class="redemption-customer-card redemption-customer-card--placeholder" data-customer-placeholder>
                  <div class="redemption-customer-card__placeholder-icon" aria-hidden="true">
                    <i class="ti ti-car"></i>
                  </div>
                  <p class="text-muted mb-0">Search by vehicle number to load the customer profile and matched vehicle.</p>
                </div>

                <div class="d-none redemption-customer-card transaction-customer-card" data-customer-panel>
                  <div class="redemption-customer-card__hero">
                    <span class="small-muted redemption-customer-card__eyebrow">Available Points</span>
                    <strong class="redemption-customer-card__value" data-customer-points></strong>
                    <span class="redemption-customer-card__note is-pending" data-customer-note></span>
                  </div>

                  <div class="redemption-customer-card__identity">
                    <div class="redemption-customer-card__identity-heading">
                      <h3 class="redemption-customer-card__name mb-0" data-customer-name></h3>
                      <span class="redemption-customer-card__status" data-customer-status></span>
                    </div>
                    <p class="redemption-customer-card__phone mb-0" data-customer-phone></p>
                  </div>

                  <div class="redemption-customer-card__stats transaction-customer-card__stats">
                    <div class="redemption-customer-card__stat">
                      <span class="redemption-customer-card__stat-label">Vehicles on File</span>
                      <strong class="redemption-customer-card__stat-value" data-customer-vehicles-count></strong>
                    </div>
                    <div class="redemption-customer-card__stat">
                      <span class="redemption-customer-card__stat-label">Selected Vehicle</span>
                      <strong class="redemption-customer-card__stat-value transaction-customer-card__stat-value" data-customer-selected-vehicle></strong>
                    </div>
                  </div>

                  <div class="transaction-customer-card__vehicles">
                    <div class="transaction-customer-card__vehicles-header">
                      <div>
                        <h3 class="h6 mb-1">Registered Vehicles</h3>
                        <p class="small-muted mb-0">The matched vehicle is highlighted below so the visit can be verified quickly.</p>
                      </div>
                    </div>

                    <div class="customer-details-vehicle-list transaction-customer-card__vehicle-list" data-customer-vehicles-list></div>
                  </div>
                </div>
              </div>

              <div class="transaction-entry-step-card__footer">
                <div class="transaction-entry-step-card__actions">
                  <button type="button" class="btn btn-outline-secondary" data-transaction-step-prev="lookup">Back</button>
                </div>
                <div class="transaction-entry-step-card__actions">
                  <button type="button" class="btn btn-primary" data-transaction-step-next="fuel" data-transaction-step-next-gate="review" data-transaction-step-focus-target="fuel-amount" disabled>Continue to Fuel</button>
                </div>
              </div>
            </div>
          </section>

          <section class="card shadow-sm transaction-entry-step-card" data-transaction-step-section="fuel" hidden>
            <div class="card-body">
              <div class="transaction-entry-step-card__header">
                <div>
                  <div class="transaction-entry-step-card__eyebrow">Step 3</div>
                  <h2 class="h4 mb-1">Fuel Details</h2>
                  <p class="transaction-entry-step-card__summary mb-0">Complete the amount and nozzle selection after the customer match is verified.</p>
                </div>
              </div>

              <fieldset class="transaction-entry-step-card__fieldset" data-transaction-step-fieldset="fuel" disabled>
                <div class="transaction-entry-step-card__body">
                  <% if vehicle_tab_active && @errors.present? && @transaction_error_step == "fuel" %>
                    <div class="alert alert-danger" data-transaction-server-error><%= @errors.to_sentence %></div>
                  <% end %>

                  <div>
                    <%= form.label :fuel_amount, "Fuel Amount (₹)", class: "form-label" %>
                    <%= form.number_field :fuel_amount, value: vehicle_tab_active ? @prefill_fuel_amount : nil, class: "form-control", step: "0.01", min: 1, required: true, data: { transaction_step_focus: "fuel-amount" } %>
                  </div>

                  <%= render "pump_selection_fields",
                    form: form,
                    transaction_fuel_pump: @transaction_fuel_pump,
                    transaction_fuel_pump_nozzles: @transaction_fuel_pump_nozzles,
                    selected_nozzle_id: @prefill_fuel_pump_nozzle_id,
                    dom_prefix: "vehicle_transaction" %>
                </div>
              </fieldset>

              <div class="transaction-entry-step-card__footer">
                <div class="transaction-entry-step-card__actions">
                  <button type="button" class="btn btn-outline-secondary" data-transaction-step-prev="review">Back</button>
                </div>
                <div class="transaction-entry-step-card__actions">
                  <%= form.submit "Save Transaction", class: "btn btn-primary", disabled: true, data: { submit_button: true } %>
                </div>
              </div>
            </div>
          </section>
        </div>
      <% end %>
    </div>
  </div>
</div>
      </div>
    </div>
  </div>
</div>

<div
  class="modal fade customer-details-modal admin-customers-modal"
  id="transactionAddCustomerModal"
  tabindex="-1"
  aria-labelledby="transactionAddCustomerModalLabel"
  aria-hidden="true"
  data-transaction-registration-modal
  data-auto-open-modal="<%= @transaction_registration_modal_open %>">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content confirm-modal-content customer-details-modal__content admin-customers-modal__content">
      <div class="modal-header border-0 pb-0">
        <div>
          <h2 class="modal-title h5 mb-1" id="transactionAddCustomerModalLabel">Add Customer</h2>
          <p class="text-muted mb-0 small">Create the customer here and continue recording the transaction without leaving this page.</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body pt-3">
        <%= render "customers/form",
          customer: registration_customer,
          form_url: register_customer_staff_transactions_path,
          form_method: :post,
          include_vehicle_fields: true,
          lock_vehicle_fields: @transaction_registration_vehicle_details_locked,
          submit_label: "Save Customer",
          title: "Add Customer",
          context: "modal",
          hidden_fields: {
            "transaction_lookup[lookup_mode]" => active_lookup_mode,
            "transaction_lookup[phone_number]" => @prefill_phone_number,
            "transaction_lookup[vehicle_number]" => @prefill_vehicle_number,
            "transaction_lookup[fuel_amount]" => @prefill_fuel_amount,
            "transaction_lookup[fuel_pump_nozzle_id]" => @prefill_fuel_pump_nozzle_id,
            "transaction_lookup[lock_vehicle_details]" => (@transaction_registration_vehicle_details_locked ? "1" : "0")
          } %>
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const numberFormatter = new Intl.NumberFormat("en-IN");
    const vehicleNumberPattern = /^[A-Z]{2}[0-9]{1,2}[A-Z]{0,3}[0-9]{1,4}$|^[0-9]{2}BH[0-9]{4}[A-Z]{2}$/;
    const normalizeVehicleNumberInput = (value) => value.toUpperCase().replace(/[^A-Z0-9]/g, "");
    const normalizeSelectionCode = (value) => value.toString().trim().toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_+|_+$/g, "");

    const buildVehicleRows = (target, vehicles, { selectedVehicleId, onVehicleSelect, emptyMessage }) => {
      target.innerHTML = "";

      if (vehicles.length === 0) {
        const emptyState = document.createElement("div");
        emptyState.className = "transaction-customer-card__vehicles-empty";
        emptyState.textContent = emptyMessage;
        target.appendChild(emptyState);
        return;
      }

      vehicles.forEach((vehicle) => {
        const element = document.createElement(onVehicleSelect ? "button" : "div");
        if (onVehicleSelect) {
          element.type = "button";
          element.addEventListener("click", () => onVehicleSelect(vehicle));
        }

        element.className = "customer-details-vehicle-row transaction-customer-card__vehicle-row";
        element.dataset.vehicleItem = "true";
        element.dataset.vehicleId = String(vehicle.id);
        element.classList.toggle("is-selected", String(vehicle.id) === String(selectedVehicleId || ""));
        element.innerHTML = `<span class="customer-details-vehicle-row__main"><span class="customer-details-vehicle-row__number">${vehicle.vehicle_number}</span><span class="customer-details-vehicle-row__meta">${vehicle.fuel_type} · ${vehicle.vehicle_kind}</span></span>`;
        target.appendChild(element);
      });
    };

    const createRegistrationModalController = () => {
      const modalElement = document.querySelector("[data-transaction-registration-modal]");
      if (!modalElement) {
        return {
          cancelPendingOpen: () => {},
          scheduleOpen: () => {}
        };
      }

      const form = modalElement.querySelector("form");
      const nameField = modalElement.querySelector("[name='customer[name]']");
      const phoneField = modalElement.querySelector("[name='customer[phone_number]']");
      const vehicleField = modalElement.querySelector("[name='customer[vehicle_number]']");
      const fuelTypeFields = modalElement.querySelectorAll("[name='customer[fuel_type]']");
      const vehicleKindFields = modalElement.querySelectorAll("[name='customer[vehicle_kind]']");
      const editableVehicleNumberGroup = modalElement.querySelector("[data-registration-editable-group='vehicle_number']");
      const editableFuelTypeGroup = modalElement.querySelector("[data-registration-editable-group='fuel_type']");
      const editableVehicleKindGroup = modalElement.querySelector("[data-registration-editable-group='vehicle_kind']");
      const lookupModeField = modalElement.querySelector("[name='transaction_lookup[lookup_mode]']");
      const lookupPhoneField = modalElement.querySelector("[name='transaction_lookup[phone_number]']");
      const lookupVehicleField = modalElement.querySelector("[name='transaction_lookup[vehicle_number]']");
      const lookupFuelAmountField = modalElement.querySelector("[name='transaction_lookup[fuel_amount]']");
      const lookupFuelPumpNozzleField = modalElement.querySelector("[name='transaction_lookup[fuel_pump_nozzle_id]']");
      const lookupLockVehicleDetailsField = modalElement.querySelector("[name='transaction_lookup[lock_vehicle_details]']");
      let focusTarget = null;
      let openTimer = null;

      const cancelPendingOpen = () => {
        if (!openTimer) return;

        window.clearTimeout(openTimer);
        openTimer = null;
      };

      modalElement.addEventListener("shown.bs.modal", () => {
        focusTarget?.focus();
      });

      modalElement.addEventListener("hidden.bs.modal", () => {
        cancelPendingOpen();
      });

      const syncLockedMirror = (name, value, locked) => {
        const selector = `[data-registration-locked-mirror="${name}"]`;
        let field = form?.querySelector(selector);

        if (!locked || value === "") {
          field?.remove();
          return;
        }

        if (!field) {
          field = document.createElement("input");
          field.type = "hidden";
          field.name = name;
          field.dataset.registrationLockedMirror = name;
          form?.appendChild(field);
        }

        field.value = value;
      };

      const syncRadioGroupSelection = (fields, rawValue) => {
        const normalizedValue = normalizeSelectionCode(rawValue);
        let selectedField = null;

        fields.forEach((field) => {
          const matches = normalizedValue !== "" && normalizeSelectionCode(field.value) === normalizedValue;
          field.checked = matches;
          field.defaultChecked = matches;
          if (matches) {
            selectedField = field;
          }
        });

        if (!selectedField) return;

        selectedField.dispatchEvent(new Event("input", { bubbles: true }));
        selectedField.dispatchEvent(new Event("change", { bubbles: true }));
        const fieldLabel = modalElement.querySelector(`label[for="${selectedField.id}"] .fuel-type-radio-group__text`)?.textContent?.trim() || selectedField.value;
        return { value: selectedField.value, label: fieldLabel };
      };

      const setVehicleDetailsLocked = ({ locked = false, selectedVehicleNumber = "", selectedFuelType = "", selectedVehicleKind = "" } = {}) => {
        if (vehicleField) {
          vehicleField.readOnly = false;
          vehicleField.disabled = locked;
        }

        fuelTypeFields.forEach((field) => {
          field.disabled = locked;
        });
        vehicleKindFields.forEach((field) => {
          field.disabled = locked;
        });

        editableVehicleNumberGroup?.classList.toggle("d-none", locked);
        editableFuelTypeGroup?.classList.toggle("d-none", locked);
        editableVehicleKindGroup?.classList.toggle("d-none", locked);

        if (lookupLockVehicleDetailsField) {
          lookupLockVehicleDetailsField.value = locked ? "1" : "0";
        }

        syncLockedMirror("customer[vehicle_number]", selectedVehicleNumber, locked);
        syncLockedMirror("customer[fuel_type]", selectedFuelType, locked);
        syncLockedMirror("customer[vehicle_kind]", selectedVehicleKind, locked);
      };

      const showNow = ({ lookupMode, phoneNumber = "", vehicleNumber = "", fuelType = "", vehicleKind = "", fuelAmount = "", fuelPumpNozzleId = "", lockVehicleDetails = false }) => {
        form?.reset();
        modalElement.querySelector(".alert.alert-danger")?.remove();

        if (nameField) nameField.value = "";
        if (phoneField) phoneField.value = phoneNumber;
        if (vehicleField) vehicleField.value = vehicleNumber;
        const selectedFuelType = syncRadioGroupSelection(fuelTypeFields, fuelType) || { value: "" };
        const selectedVehicleKind = syncRadioGroupSelection(vehicleKindFields, vehicleKind) || { value: "" };
        setVehicleDetailsLocked({
          locked: lockVehicleDetails,
          selectedVehicleNumber: vehicleNumber,
          selectedFuelType: selectedFuelType.value,
          selectedVehicleKind: selectedVehicleKind.value
        });
        if (lookupModeField) lookupModeField.value = lookupMode;
        if (lookupPhoneField) lookupPhoneField.value = phoneNumber;
        if (lookupVehicleField) lookupVehicleField.value = vehicleNumber;
        if (lookupFuelAmountField) lookupFuelAmountField.value = fuelAmount;
        if (lookupFuelPumpNozzleField) lookupFuelPumpNozzleField.value = fuelPumpNozzleId;

        focusTarget = nameField || phoneField || vehicleField;
        bootstrap.Modal.getOrCreateInstance(modalElement).show();
      };

      const openNow = (payload) => {
        cancelPendingOpen();
        showNow(payload);
      };

      const scheduleOpen = (payload) => {
        cancelPendingOpen();
        openTimer = window.setTimeout(() => {
          openTimer = null;
          showNow(payload);
        }, 2000);
      };

      return { cancelPendingOpen, openNow, scheduleOpen };
    };

    const registrationModal = createRegistrationModalController();
    const normalizeFuelTypeCode = (value) => {
      if (value === null || value === undefined) return "";

      return value
        .toString()
        .trim()
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "_")
        .replace(/^_+|_+$/g, "");
    };

    const bindTransactionNozzleOptions = (root, onChange) => {
      const nozzleEntries = Array.from(root.querySelectorAll("[data-transaction-nozzle-option]"))
        .map((option) => ({
          option,
          input: option.querySelector("[data-transaction-nozzle-input]")
        }))
        .filter(({ input }) => Boolean(input));
      const nozzleInputs = nozzleEntries.map(({ input }) => input);
      const status = root.querySelector("[data-transaction-nozzle-status]");
      let activeFuelTypeCode = "";
      let activeFuelTypeLabel = "";
      let preferredNozzleId = nozzleInputs.find((input) => input.checked)?.value || "";

      const selectedInput = () => nozzleInputs.find((input) => input.checked && !input.disabled);
      const compatibleEntries = () => nozzleEntries.filter(({ input }) => !input.disabled);
      const fuelTypeLabel = () => {
        if (activeFuelTypeLabel) return activeFuelTypeLabel;
        if (activeFuelTypeCode === "cng_lpg") return "CNG / LPG";

        return activeFuelTypeCode
          .split("_")
          .filter(Boolean)
          .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
          .join(" ");
      };

      const setStatus = (message, tone = "neutral") => {
        if (!status) return;

        status.textContent = message;
        status.classList.toggle("d-none", message === "");
        status.classList.toggle("text-muted", tone === "neutral");
        status.classList.toggle("text-success", tone === "success");
        status.classList.toggle("text-danger", tone === "warning");
      };

      const syncRequiredInputs = (enabledInputs) => {
        nozzleInputs.forEach((input) => {
          input.required = false;
        });

        if (enabledInputs.length > 0) {
          enabledInputs[0].required = true;
        }
      };

      const syncCompatibilityStatus = () => {
        if (!activeFuelTypeCode) {
          setStatus("Select a vehicle to see compatible nozzles.", "neutral");
          return;
        }

        const availableEntries = compatibleEntries();
        if (availableEntries.length === 0) {
          setStatus(`No ${fuelTypeLabel()} nozzle is assigned to your pump for this vehicle.`, "warning");
          return;
        }

        if (!selectedInput()) {
          setStatus(`Choose one of the displayed ${fuelTypeLabel()} nozzles to continue.`, "neutral");
          return;
        }

        setStatus(`${fuelTypeLabel()} nozzle selected for this vehicle.`, "success");
      };

      const applyFuelTypeConstraint = (fuelTypeCode, fuelTypeLabelText = "") => {
        activeFuelTypeCode = normalizeFuelTypeCode(fuelTypeCode);
        activeFuelTypeLabel = fuelTypeLabelText;

        const matchingEntries = activeFuelTypeCode
          ? nozzleEntries.filter(({ input }) => normalizeFuelTypeCode(input.dataset.nozzleFuelType) === activeFuelTypeCode)
          : [];

        nozzleEntries.forEach(({ option, input }) => {
          const compatible = matchingEntries.some((entry) => entry.input === input);
          const constrainChoices = activeFuelTypeCode !== "";

          option.classList.toggle("d-none", constrainChoices && !compatible);
          input.disabled = !constrainChoices || !compatible;

          if (input.disabled) {
            input.checked = false;
          }
        });

        let nextSelectedInput = selectedInput();

        if (!nextSelectedInput && preferredNozzleId) {
          nextSelectedInput = matchingEntries.find(({ input }) => input.value === preferredNozzleId)?.input || null;
        }

        if (!nextSelectedInput && matchingEntries.length === 1) {
          nextSelectedInput = matchingEntries[0].input;
        }

        if (nextSelectedInput) {
          nextSelectedInput.checked = true;
          preferredNozzleId = nextSelectedInput.value;
        }

        syncRequiredInputs(matchingEntries.map(({ input }) => input));
        syncCompatibilityStatus();
        onChange();
      };

      nozzleInputs.forEach((input) => {
        input.addEventListener("change", () => {
          if (input.checked) {
            preferredNozzleId = input.value;
          }

          onChange();
          syncCompatibilityStatus();
        });
      });

      nozzleEntries.forEach(({ option, input }) => {
        option.addEventListener("click", (event) => {
          if (!input || input.disabled) return;

          event.preventDefault();

          if (!input.checked) {
            input.checked = true;
            input.dispatchEvent(new Event("change", { bubbles: true }));
            return;
          }

          onChange();
        });
      });

      applyFuelTypeConstraint(null);

      return {
        applyFuelTypeConstraint,
        selectedInput
      };
    };

    const createCustomerCardController = (root) => {
      const placeholder = root.querySelector("[data-customer-placeholder]");
      const panel = root.querySelector("[data-customer-panel]");
      const errorBox = root.querySelector("[data-customer-error]");
      const nameTarget = root.querySelector("[data-customer-name]");
      const phoneTarget = root.querySelector("[data-customer-phone]");
      const statusTarget = root.querySelector("[data-customer-status]");
      const pointsTarget = root.querySelector("[data-customer-points]");
      const noteTarget = root.querySelector("[data-customer-note]");
      const vehiclesCountTarget = root.querySelector("[data-customer-vehicles-count]");
      const selectedVehicleTarget = root.querySelector("[data-customer-selected-vehicle]");
      const vehiclesListTarget = root.querySelector("[data-customer-vehicles-list]");
      let suppressNextBlurLookup = false;

      errorBox.addEventListener("pointerdown", (event) => {
        if (event.target.closest("[data-register-customer-link]")) {
          suppressNextBlurLookup = true;
        }
      });

      const clearError = () => {
        errorBox.replaceChildren();
        errorBox.classList.add("d-none");
      };

      const consumeBlurSuppression = () => {
        const shouldSuppress = suppressNextBlurLookup;
        suppressNextBlurLookup = false;
        return shouldSuppress;
      };

      const setError = (message, { keepPanel = false, registerCustomerPath = "", onRegisterCustomer = null } = {}) => {
        errorBox.replaceChildren();

        if (message) {
          const messageNode = document.createElement("span");
          messageNode.textContent = message;
          errorBox.appendChild(messageNode);
        }

        if (registerCustomerPath || onRegisterCustomer) {
          const registerLink = document.createElement("a");
          registerLink.href = registerCustomerPath || "#";
          registerLink.className = "transaction-customer-register-link";
          registerLink.textContent = "Register customer";
          registerLink.dataset.registerCustomerLink = "true";
          if (onRegisterCustomer) {
            registerLink.addEventListener("click", (event) => {
              event.preventDefault();
              onRegisterCustomer();
            });
          }
          errorBox.appendChild(registerLink);
        }

        errorBox.classList.remove("d-none");
        panel.classList.toggle("d-none", !keepPanel);
        placeholder.classList.toggle("d-none", keepPanel);
      };

      const clearPanel = () => {
        clearError();
        panel.classList.add("d-none");
        placeholder.classList.remove("d-none");
        nameTarget.textContent = "";
        phoneTarget.textContent = "";
        statusTarget.textContent = "";
        statusTarget.className = "redemption-customer-card__status";
        pointsTarget.textContent = "";
        noteTarget.textContent = "";
        noteTarget.className = "redemption-customer-card__note is-pending";
        vehiclesCountTarget.textContent = "";
        selectedVehicleTarget.textContent = "";
        vehiclesListTarget.innerHTML = "";
      };

      const renderCustomer = (customer, { selectedVehicleId = "", noteText = "", noteState = "is-pending", onVehicleSelect = null, emptyMessage = "No registered vehicles available for this customer yet." } = {}) => {
        clearError();
        placeholder.classList.add("d-none");
        panel.classList.remove("d-none");
        nameTarget.textContent = customer.name;
        phoneTarget.textContent = customer.phone_number;
        statusTarget.textContent = customer.status_label;
        statusTarget.className = `redemption-customer-card__status ${customer.active ? "is-active" : "is-inactive"}`;
        pointsTarget.textContent = numberFormatter.format(customer.total_points || 0);
        noteTarget.textContent = noteText;
        noteTarget.className = `redemption-customer-card__note ${noteState}`;
        vehiclesCountTarget.textContent = customer.vehicles.length;

        const selectedVehicle = customer.vehicles.find((vehicle) => String(vehicle.id) === String(selectedVehicleId || ""));
        selectedVehicleTarget.textContent = selectedVehicle ? selectedVehicle.vehicle_number : (customer.vehicles.length > 0 ? "Not selected" : "None");

        buildVehicleRows(vehiclesListTarget, customer.vehicles, {
          selectedVehicleId,
          onVehicleSelect,
          emptyMessage
        });
      };

      return {
        clearPanel,
        clearError,
        consumeBlurSuppression,
        setError,
        renderCustomer
      };
    };

    const createTransactionWizardController = (root) => {
      const wizardKey = root.dataset.transactionWizardKey || "";
      const requestedErrorStep = ["lookup", "review", "fuel"].includes(root.dataset.transactionErrorStep) ? root.dataset.transactionErrorStep : "";
      const stepper = wizardKey ? document.querySelector(`[data-transaction-page-stepper="${wizardKey}"]`) : null;
      const markers = stepper ? Array.from(stepper.querySelectorAll("[data-transaction-step-marker]")) : [];
      const sections = Object.fromEntries(
        Array.from(root.querySelectorAll("[data-transaction-step-section]")).map((section) => [section.dataset.transactionStepSection, section])
      );
      const fieldsets = Object.fromEntries(
        Array.from(root.querySelectorAll("[data-transaction-step-fieldset]")).map((fieldset) => [fieldset.dataset.transactionStepFieldset, fieldset])
      );
      const nextButtons = Array.from(root.querySelectorAll("[data-transaction-step-next]"));
      const prevButtons = Array.from(root.querySelectorAll("[data-transaction-step-prev]"));
      const stepOrder = ["lookup", "review", "fuel"];
      const statusLabels = {
        locked: "Locked",
        pending: "Next",
        ready: "Ready",
        current: "Current",
        complete: "Done"
      };
      let activeStep = null;
      let pendingRequestedStep = requestedErrorStep;
      let latestCompletion = {
        lookupComplete: false,
        reviewComplete: false,
        fuelComplete: false
      };

      const lockedSteps = ({ lookupComplete, reviewComplete }) => ({
        lookup: false,
        review: !lookupComplete,
        fuel: !reviewComplete
      });

      const defaultStep = ({ lookupComplete, reviewComplete }) => (
        !lookupComplete ? "lookup" : (!reviewComplete ? "review" : "fuel")
      );

      const modalElement = document.querySelector("[data-transaction-entry-modal]");
      const focusStepTarget = (stepKey, focusTarget) => {
        if (!focusTarget) return;

        const section = sections[stepKey];
        if (!section || section.hidden) return;

        const target = section.querySelector(`[data-transaction-step-focus="${focusTarget}"]`);
        if (!target || target.disabled) return;

        window.requestAnimationFrame(() => {
          if (section.hidden) return;

          try {
            target.focus({ preventScroll: true });
          } catch (_error) {
            target.focus();
          }

          if (typeof target.setSelectionRange === "function") {
            const cursorPosition = target.value.length;
            target.setSelectionRange(cursorPosition, cursorPosition);
          }
        });
      };

      const showStep = (stepKey, { smooth = true, focusTarget = "" } = {}) => {
        const section = sections[stepKey];
        if (!section) return;

        const locked = lockedSteps(latestCompletion);
        if (locked[stepKey]) return;

        activeStep = stepKey;
        sync(latestCompletion, { preserveCurrentStep: true });
        const revealStep = () => {
          const nextSection = sections[stepKey];
          if (!nextSection) return;

          nextSection.scrollIntoView({ behavior: smooth ? "smooth" : "auto", block: "start" });
          focusStepTarget(stepKey, focusTarget);
        };

        if (modalElement && !modalElement.classList.contains("show")) {
          modalElement.addEventListener("shown.bs.modal", revealStep, { once: true });
          bootstrap.Modal.getOrCreateInstance(modalElement).show();
          return;
        }

        revealStep();
      };

      markers.forEach((marker) => {
        marker.addEventListener("click", () => {
          if (marker.disabled) return;

          const stepKey = marker.dataset.transactionStepTarget;
          showStep(stepKey);
        });
      });

      nextButtons.forEach((button) => {
        button.addEventListener("click", () => {
          showStep(button.dataset.transactionStepNext, {
            focusTarget: button.dataset.transactionStepFocusTarget || ""
          });
        });
      });

      prevButtons.forEach((button) => {
        button.addEventListener("click", () => {
          showStep(button.dataset.transactionStepPrev);
        });
      });

      const sync = ({ lookupComplete = false, reviewComplete = false, fuelComplete = false } = {}, { preserveCurrentStep = false } = {}) => {
        latestCompletion = {
          lookup: lookupComplete,
          review: reviewComplete,
          fuel: fuelComplete
        };
        latestCompletion.lookupComplete = lookupComplete;
        latestCompletion.reviewComplete = reviewComplete;
        latestCompletion.fuelComplete = fuelComplete;

        const completion = {
          lookup: lookupComplete,
          review: reviewComplete,
          fuel: fuelComplete
        };
        const locked = lockedSteps(latestCompletion);
        const currentStep = defaultStep(latestCompletion);

        if (!preserveCurrentStep && pendingRequestedStep && !locked[pendingRequestedStep]) {
          activeStep = pendingRequestedStep;
          pendingRequestedStep = "";
        }

        if (!preserveCurrentStep && (!activeStep || locked[activeStep])) {
          activeStep = currentStep;
        }

        if (!activeStep) {
          activeStep = currentStep;
        }

        stepOrder.forEach((stepKey) => {
          const marker = markers.find((entry) => entry.dataset.transactionStepMarker === stepKey);
          const section = sections[stepKey];
          const fieldset = fieldsets[stepKey];
          const activeStepIndex = stepOrder.indexOf(activeStep);
          const stepIndex = stepOrder.indexOf(stepKey);
          const state = activeStep === stepKey
            ? "current"
            : (
              stepIndex < activeStepIndex && completion[stepKey]
                ? "complete"
                : (locked[stepKey] ? "locked" : (completion[stepKey] ? "ready" : "pending"))
            );

          if (marker) {
            marker.dataset.state = state;
            marker.disabled = locked[stepKey];
            marker.classList.toggle("is-complete", state === "complete");
            marker.classList.toggle("is-current", state === "current");
            marker.classList.toggle("is-ready", state === "ready");
            marker.classList.toggle("is-locked", state === "locked");

            const status = marker.querySelector("[data-transaction-step-status]");
            if (status) {
              status.textContent = statusLabels[state];
            }
          }

          if (section) {
            section.dataset.state = state;
            section.hidden = activeStep !== stepKey;
            section.classList.toggle("is-complete", state === "complete");
            section.classList.toggle("is-current", state === "current");
            section.classList.toggle("is-ready", state === "ready");
            section.classList.toggle("is-locked", state === "locked");
          }

          if (fieldset) {
            fieldset.disabled = locked[stepKey];
          }
        });

        nextButtons.forEach((button) => {
          const gate = button.dataset.transactionStepNextGate;
          const enabled = gate === "lookup" ? lookupComplete : (gate === "review" ? reviewComplete : true);
          button.disabled = !enabled;
        });
      };

      return { sync, showStep };
    };

    const initializePhoneLookup = () => {
      document.querySelectorAll("[data-transaction-phone-root]").forEach((root) => {
        if (root.__lookupBound === true) return;
        root.__lookupBound = true;

        const lookupUrl = root.dataset.lookupUrl;
        const preselectedVehicleId = root.dataset.selectedVehicleId;
        const phoneInput = root.querySelector("[data-phone-input]");
        const vehicleSelect = root.querySelector("[data-vehicle-select]");
        const fuelAmountInput = root.querySelector("input[name='transaction[fuel_amount]']");
        const submitButton = root.querySelector("[data-submit-button]");
        const card = createCustomerCardController(root);
        const wizard = createTransactionWizardController(root);
        const serverErrors = Array.from(root.querySelectorAll("[data-transaction-server-error]"));
        let activeLookup = 0;
        let customerActive = false;
        let currentCustomer = null;
        let suppressVehicleSelectBlurLookup = false;

        const clearServerErrors = () => {
          serverErrors.forEach((alert) => alert.classList.add("d-none"));
        };

        const resetVehicleSelect = () => {
          vehicleSelect.innerHTML = "";
          const prompt = document.createElement("option");
          prompt.value = "";
          prompt.textContent = "Select a vehicle";
          vehicleSelect.appendChild(prompt);
          vehicleSelect.value = "";
          vehicleSelect.disabled = true;
          submitButton.disabled = true;
        };

        const selectedVehicle = () => currentCustomer?.vehicles.find((vehicle) => String(vehicle.id) === String(vehicleSelect.value || ""));
        const fuelAmountValid = () => {
          const value = Number.parseFloat(fuelAmountInput?.value || "");
          return Number.isFinite(value) && value > 0;
        };
        let nozzleController = null;
        const selectedNozzleInput = () => nozzleController?.selectedInput();
        const syncWizardState = () => {
          const reviewReady = customerActive && Boolean(selectedVehicle());
          wizard.sync({
            lookupComplete: Boolean(currentCustomer),
            reviewComplete: reviewReady,
            fuelComplete: reviewReady && fuelAmountValid() && Boolean(selectedNozzleInput())
          });
        };
        const syncSubmitState = () => {
          submitButton.disabled = vehicleSelect.value === "" || !customerActive || !selectedNozzleInput() || !fuelAmountValid();
          syncWizardState();
        };
        nozzleController = bindTransactionNozzleOptions(root, () => syncSubmitState());
        const syncNozzlesForSelectedVehicle = () => {
          const vehicle = selectedVehicle();
          nozzleController.applyFuelTypeConstraint(vehicle?.fuel_type_code, vehicle?.fuel_type);
        };

        const syncCustomerCard = () => {
          if (!currentCustomer) {
            card.clearPanel();
            return;
          }

          let noteText = "Select the matching vehicle for this visit";
          let noteState = "is-pending";

          if (!customerActive) {
            noteText = "Customer must be active before recording a transaction";
          } else if (currentCustomer.vehicles.length === 0) {
            noteText = "Add a vehicle before recording fuel";
          } else if (selectedVehicle()) {
            noteText = "Ready to record fuel for the selected vehicle";
            noteState = "is-redeemable";
          } else if (currentCustomer.vehicles.length === 1) {
            noteText = "1 vehicle ready for this visit";
          }

          card.renderCustomer(currentCustomer, {
            selectedVehicleId: vehicleSelect.value,
            noteText,
            noteState,
            onVehicleSelect: (vehicle) => {
              if (vehicleSelect.disabled) return;
              vehicleSelect.value = String(vehicle.id);
              syncNozzlesForSelectedVehicle();
              syncSubmitState();
              syncCustomerCard();
            }
          });
        };

        const loadCustomer = async () => {
          const phoneNumber = phoneInput.value.replace(/\D/g, "");

          if (phoneNumber.length !== 10) {
            registrationModal.cancelPendingOpen();
            currentCustomer = null;
            customerActive = false;
            card.clearPanel();
            resetVehicleSelect();
            nozzleController.applyFuelTypeConstraint(null);
            return;
          }

          const lookupId = ++activeLookup;

          try {
            const response = await fetch(`${lookupUrl}?phone_number=${encodeURIComponent(phoneNumber)}`, {
              headers: { Accept: "application/json" }
            });

            const payload = await response.json();
            if (lookupId !== activeLookup) return;

            if (!response.ok || !payload.found) {
              const registrationPayload = {
                lookupMode: "phone",
                phoneNumber,
                fuelAmount: root.querySelector("input[name='transaction[fuel_amount]']")?.value || "",
                fuelPumpNozzleId: selectedNozzleInput()?.value || ""
              };
              currentCustomer = null;
              customerActive = false;
              resetVehicleSelect();
              nozzleController.applyFuelTypeConstraint(null);
              card.setError(payload.message || "Customer not found for that phone number.", {
                registerCustomerPath: payload.register_customer_path,
                onRegisterCustomer: () => registrationModal.openNow(registrationPayload)
              });
              registrationModal.scheduleOpen(registrationPayload);
              return;
            }

            registrationModal.cancelPendingOpen();
            currentCustomer = payload.customer;
            customerActive = payload.customer.active;
            resetVehicleSelect();

            payload.customer.vehicles.forEach((vehicle) => {
              const option = document.createElement("option");
              option.value = vehicle.id;
              option.textContent = vehicle.display_name;
              vehicleSelect.appendChild(option);
            });

            if (payload.customer.vehicles.length > 0) {
              vehicleSelect.disabled = false;

              if (preselectedVehicleId && payload.customer.vehicles.some((vehicle) => String(vehicle.id) === String(preselectedVehicleId))) {
                vehicleSelect.value = String(preselectedVehicleId);
              } else if (payload.customer.vehicles.length === 1) {
                vehicleSelect.value = String(payload.customer.vehicles[0].id);
              }
            }

            syncNozzlesForSelectedVehicle();
            syncSubmitState();
            syncCustomerCard();

            if (!payload.customer.active) {
              vehicleSelect.disabled = true;
              submitButton.disabled = true;
              card.setError("This customer is inactive. Activate the customer before recording a transaction.", { keepPanel: true });
            } else if (payload.customer.vehicles.length === 0) {
              card.setError("This customer does not have any registered vehicles yet.", { keepPanel: true });
            }
          } catch (_error) {
            if (lookupId !== activeLookup) return;
            registrationModal.cancelPendingOpen();
            currentCustomer = null;
            customerActive = false;
            resetVehicleSelect();
            nozzleController.applyFuelTypeConstraint(null);
            card.setError("Unable to fetch customer details right now.");
          }
        };

        let lookupTimer;

        phoneInput.addEventListener("input", () => {
          registrationModal.cancelPendingOpen();
          clearServerErrors();
          clearTimeout(lookupTimer);
          lookupTimer = setTimeout(loadCustomer, 300);
        });

        phoneInput.addEventListener("blur", (event) => {
          if (event.relatedTarget === vehicleSelect || suppressVehicleSelectBlurLookup) {
            suppressVehicleSelectBlurLookup = false;
            return;
          }

          if (card.consumeBlurSuppression()) return;

          loadCustomer();
        });

        vehicleSelect.addEventListener("pointerdown", () => {
          if (document.activeElement === phoneInput) {
            suppressVehicleSelectBlurLookup = true;
          }
        });

        vehicleSelect.addEventListener("change", () => {
          clearServerErrors();
          syncNozzlesForSelectedVehicle();
          syncSubmitState();
          syncCustomerCard();
        });

        fuelAmountInput?.addEventListener("input", () => {
          clearServerErrors();
          syncSubmitState();
        });
        fuelAmountInput?.addEventListener("change", () => {
          clearServerErrors();
          syncSubmitState();
        });

        root.querySelectorAll("[data-transaction-nozzle-input]").forEach((input) => {
          input.addEventListener("change", clearServerErrors);
        });

        if (phoneInput.value.trim() !== "") {
          loadCustomer();
        } else {
          registrationModal.cancelPendingOpen();
          card.clearPanel();
          resetVehicleSelect();
          nozzleController.applyFuelTypeConstraint(null);
        }

        syncWizardState();
      });
    };

    const initializeVehicleLookup = () => {
      document.querySelectorAll("[data-transaction-vehicle-root]").forEach((root) => {
        if (root.__lookupBound === true) return;
        root.__lookupBound = true;

        const lookupUrl = root.dataset.lookupUrl;
        const preselectedVehicleId = root.dataset.selectedVehicleId;
        const vehicleNumberInput = root.querySelector("[data-vehicle-number-input]");
        const matchSelect = root.querySelector("[data-vehicle-select]");
        const fuelAmountInput = root.querySelector("input[name='transaction[fuel_amount]']");
        const submitButton = root.querySelector("[data-submit-button]");
        const registerCustomerButton = root.querySelector("[data-transaction-register-customer-trigger]");
        const card = createCustomerCardController(root);
        const wizard = createTransactionWizardController(root);
        const serverErrors = Array.from(root.querySelectorAll("[data-transaction-server-error]"));
        let activeLookup = 0;
        let currentMatches = [];
        let selectedMatch = null;
        let suppressMatchSelectBlurLookup = false;

        const clearServerErrors = () => {
          serverErrors.forEach((alert) => alert.classList.add("d-none"));
        };

        const focusVehicleNumberInput = () => {
          if (!vehicleNumberInput || !vehicleNumberInput.hasAttribute("autofocus")) return;
          if (!transactionEntryModalVisible()) return;
          if (vehicleScannerFocusLockActive()) return;

          const activePane = root.closest(".tab-pane");
          if (activePane && (!activePane.classList.contains("show") || !activePane.classList.contains("active"))) return;
          if (document.activeElement && document.activeElement !== document.body) return;

          window.requestAnimationFrame(() => {
            vehicleNumberInput.focus({ preventScroll: true });
            const cursorPosition = vehicleNumberInput.value.length;
            vehicleNumberInput.setSelectionRange(cursorPosition, cursorPosition);
          });
        };

        const resetMatchSelect = () => {
          matchSelect.innerHTML = "";
          const prompt = document.createElement("option");
          prompt.value = "";
          prompt.textContent = "Select the matching customer";
          matchSelect.appendChild(prompt);
          matchSelect.value = "";
          matchSelect.disabled = true;
          submitButton.disabled = true;
        };

        let nozzleController = null;
        const selectedNozzleInput = () => nozzleController?.selectedInput();
        const buildRegistrationPayload = () => ({
          lookupMode: "vehicle",
          vehicleNumber: normalizeVehicleNumberInput(vehicleNumberInput?.value || ""),
          fuelType: selectedMatch?.fuel_type_code || selectedMatch?.fuel_type || "",
          vehicleKind: selectedMatch?.vehicle_kind_code || selectedMatch?.vehicle_kind || "",
          lockVehicleDetails: Boolean(
            normalizeVehicleNumberInput(vehicleNumberInput?.value || "") &&
            (selectedMatch?.fuel_type_code || selectedMatch?.fuel_type) &&
            (selectedMatch?.vehicle_kind_code || selectedMatch?.vehicle_kind)
          ),
          fuelAmount: root.querySelector("input[name='transaction[fuel_amount]']")?.value || "",
          fuelPumpNozzleId: selectedNozzleInput()?.value || ""
        });
        const fuelAmountValid = () => {
          const value = Number.parseFloat(fuelAmountInput?.value || "");
          return Number.isFinite(value) && value > 0;
        };
        const syncWizardState = () => {
          const reviewReady = Boolean(selectedMatch) && Boolean(selectedMatch?.customer?.active);
          wizard.sync({
            lookupComplete: currentMatches.length > 0,
            reviewComplete: reviewReady,
            fuelComplete: reviewReady && fuelAmountValid() && Boolean(selectedNozzleInput())
          });
        };
        const syncSubmitState = () => {
          submitButton.disabled = !selectedMatch || !selectedMatch.customer.active || !selectedNozzleInput() || !fuelAmountValid();
          syncWizardState();
        };
        nozzleController = bindTransactionNozzleOptions(root, () => syncSubmitState());
        const syncNozzlesForSelectedMatch = () => {
          nozzleController.applyFuelTypeConstraint(selectedMatch?.fuel_type_code, selectedMatch?.fuel_type);
        };

        const syncCustomerCard = () => {
          if (!selectedMatch) {
            card.clearPanel();
            return;
          }

          let noteText = "Ready to record fuel for the entered vehicle";
          let noteState = "is-redeemable";

          if (!selectedMatch.customer.active) {
            noteText = "Customer must be active before recording a transaction";
            noteState = "is-pending";
          }

          card.renderCustomer(selectedMatch.customer, {
            selectedVehicleId: selectedMatch.vehicle_id,
            noteText,
            noteState
          });
        };

        const syncRegisterCustomerButton = () => {
          if (!registerCustomerButton) return;

          const vehicleNumber = buildRegistrationPayload().vehicleNumber;
          const enabled = vehicleNumber !== "";
          registerCustomerButton.disabled = !enabled;
          registerCustomerButton.title = enabled ? `Add customer for ${vehicleNumber}` : "Enter a vehicle number to add a customer";
        };

        const applySelection = () => {
          selectedMatch = currentMatches.find((match) => String(match.vehicle_id) === String(matchSelect.value || "")) || null;
          syncNozzlesForSelectedMatch();
          syncSubmitState();
          syncCustomerCard();

          if (!selectedMatch && currentMatches.length > 1) {
            card.setError("Multiple customers use this vehicle number. Select the correct customer to continue.");
            return;
          }

          if (selectedMatch && !selectedMatch.customer.active) {
            card.setError("This customer is inactive. Activate the customer before recording a transaction.", { keepPanel: true });
          }
        };

        const loadMatches = async ({ force = false } = {}) => {
          vehicleNumberInput.value = normalizeVehicleNumberInput(vehicleNumberInput.value);
          const vehicleNumber = vehicleNumberInput.value;

          if (vehicleNumber === "") {
            registrationModal.cancelPendingOpen();
            currentMatches = [];
            selectedMatch = null;
            card.clearPanel();
            resetMatchSelect();
            nozzleController.applyFuelTypeConstraint(null);
            return;
          }

          if (!force && vehicleNumber.length < 6) {
            registrationModal.cancelPendingOpen();
            currentMatches = [];
            selectedMatch = null;
            card.clearPanel();
            resetMatchSelect();
            nozzleController.applyFuelTypeConstraint(null);
            return;
          }

          const lookupId = ++activeLookup;

          try {
            const response = await fetch(`${lookupUrl}?vehicle_number=${encodeURIComponent(vehicleNumber)}`, {
              headers: { Accept: "application/json" }
            });

            const payload = await response.json();
            if (lookupId !== activeLookup) return;

            if (!response.ok || !payload.found) {
              const registrationPayload = buildRegistrationPayload();
              currentMatches = [];
              selectedMatch = null;
              resetMatchSelect();
              nozzleController.applyFuelTypeConstraint(null);
              card.setError(payload.message || "No customer was found for that vehicle number.", {
                registerCustomerPath: payload.register_customer_path,
                onRegisterCustomer: () => registrationModal.openNow(registrationPayload)
              });

              if (vehicleNumberPattern.test(vehicleNumber)) {
                registrationModal.scheduleOpen(registrationPayload);
              } else {
                registrationModal.cancelPendingOpen();
              }

              return;
            }

            registrationModal.cancelPendingOpen();
            currentMatches = payload.matches || [];
            selectedMatch = null;
            resetMatchSelect();

            currentMatches.forEach((match) => {
              const option = document.createElement("option");
              option.value = match.vehicle_id;
              option.textContent = `${match.customer.name} · +91 ${match.customer.phone_number}`;
              matchSelect.appendChild(option);
            });

            if (currentMatches.length > 0) {
              matchSelect.disabled = false;

              if (preselectedVehicleId && currentMatches.some((match) => String(match.vehicle_id) === String(preselectedVehicleId))) {
                matchSelect.value = String(preselectedVehicleId);
              } else if (currentMatches.length === 1) {
                matchSelect.value = String(currentMatches[0].vehicle_id);
              }
            }

            applySelection();
          } catch (_error) {
            if (lookupId !== activeLookup) return;
            registrationModal.cancelPendingOpen();
            currentMatches = [];
            selectedMatch = null;
            resetMatchSelect();
            nozzleController.applyFuelTypeConstraint(null);
            card.setError("Unable to fetch vehicle details right now.");
          }
        };

        const syncVehicleNumberValidity = () => {
          if (vehicleNumberInput.value === "" || vehicleNumberPattern.test(vehicleNumberInput.value)) {
            vehicleNumberInput.setCustomValidity("");
            return;
          }

          vehicleNumberInput.setCustomValidity("Enter a valid vehicle number.");
        };

        let lookupTimer;

        vehicleNumberInput.addEventListener("input", () => {
          registrationModal.cancelPendingOpen();
          clearServerErrors();
          vehicleNumberInput.value = normalizeVehicleNumberInput(vehicleNumberInput.value);
          syncVehicleNumberValidity();
          syncRegisterCustomerButton();
          clearTimeout(lookupTimer);
          lookupTimer = setTimeout(() => loadMatches({ force: false }), 300);
        });

        vehicleNumberInput.addEventListener("blur", (event) => {
          syncVehicleNumberValidity();
          if (event.relatedTarget === matchSelect || suppressMatchSelectBlurLookup) {
            suppressMatchSelectBlurLookup = false;
            return;
          }

          if (card.consumeBlurSuppression()) return;

          loadMatches({ force: true });
        });

        vehicleNumberInput.addEventListener("invalid", syncVehicleNumberValidity);

        matchSelect.addEventListener("pointerdown", () => {
          if (document.activeElement === vehicleNumberInput) {
            suppressMatchSelectBlurLookup = true;
          }
        });

        matchSelect.addEventListener("change", () => {
          clearServerErrors();
          applySelection();
        });
        registerCustomerButton?.addEventListener("click", () => {
          const registrationPayload = buildRegistrationPayload();
          if (registrationPayload.vehicleNumber === "") return;

          registrationModal.cancelPendingOpen();
          clearServerErrors();
          registrationModal.openNow(registrationPayload);
        });
        fuelAmountInput?.addEventListener("input", () => {
          clearServerErrors();
          syncSubmitState();
        });
        fuelAmountInput?.addEventListener("change", () => {
          clearServerErrors();
          syncSubmitState();
        });

        root.querySelectorAll("[data-transaction-nozzle-input]").forEach((input) => {
          input.addEventListener("change", clearServerErrors);
        });

        if (vehicleNumberInput.value.trim() !== "") {
          syncVehicleNumberValidity();
          syncRegisterCustomerButton();
          loadMatches({ force: true });
        } else {
          registrationModal.cancelPendingOpen();
          card.clearPanel();
          resetMatchSelect();
          nozzleController.applyFuelTypeConstraint(null);
          syncRegisterCustomerButton();
        }

        syncRegisterCustomerButton();
        syncWizardState();
        focusVehicleNumberInput();
      });
    };

    const lookupFocusTimers = {};
    const transactionEntryModalElement = () => document.querySelector("[data-transaction-entry-modal]");
    const transactionEntryModalVisible = () => {
      const modalElement = transactionEntryModalElement();
      return !modalElement || modalElement.classList.contains("show");
    };
    const vehicleScannerFocusLockActive = () => {
      const scannerRoot = document.querySelector("[data-plate-scanner-root]");
      if (!scannerRoot) return false;
      if (scannerRoot.classList.contains("is-open")) return true;

      return scannerRoot.dataset.autoOpenPending === "true" ||
        (scannerRoot.dataset.autoOpen === "true" && scannerRoot.dataset.autoOpenPending !== "false");
    };

    const shouldSkipLookupFocus = (targetKey) => targetKey === "vehicle" && vehicleScannerFocusLockActive();
    const syncPageStepperVisibility = (targetKey) => {
      document.querySelectorAll("[data-transaction-page-stepper]").forEach((stepper) => {
        stepper.classList.toggle("d-none", stepper.dataset.transactionPageStepper !== targetKey);
      });
    };
    const syncLookupTabDescription = (button) => {
      const target = document.querySelector("[data-lookup-tab-description-target]");
      if (!target || !button) return;

      target.textContent = button.dataset.lookupTabDescription || "";
    };

    const focusLookupInputNow = (targetKey) => {
      if (!transactionEntryModalVisible()) return;
      if (shouldSkipLookupFocus(targetKey)) return;

      const input = document.querySelector(`[data-lookup-focus-input="${targetKey}"]`);
      if (!input) return;

      const activePane = input.closest(".tab-pane");
      if (activePane) {
        activePane.classList.add("active", "show");
      }

      try {
        input.focus({ preventScroll: true });
      } catch (_error) {
        input.focus();
      }

      if (typeof input.setSelectionRange === "function") {
        const cursorPosition = input.value.length;
        input.setSelectionRange(cursorPosition, cursorPosition);
      }
    };

    const focusLookupInput = (targetKey, { preserveExistingFocus = false } = {}) => {
      if (!transactionEntryModalVisible()) return;
      if (shouldSkipLookupFocus(targetKey)) return;

      const input = document.querySelector(`[data-lookup-focus-input="${targetKey}"]`);
      if (!input) return;

      const activePane = input.closest(".tab-pane");
      if (activePane && (!activePane.classList.contains("show") || !activePane.classList.contains("active"))) return;
      if (preserveExistingFocus && document.activeElement && document.activeElement !== document.body) return;

      window.requestAnimationFrame(() => {
        try {
          input.focus({ preventScroll: true });
        } catch (_error) {
          input.focus();
        }

        if (typeof input.setSelectionRange === "function") {
          const cursorPosition = input.value.length;
          input.setSelectionRange(cursorPosition, cursorPosition);
        }
      });
    };

    const queueLookupInputFocus = (targetKey, options = {}) => {
      if (!transactionEntryModalVisible()) return;
      if (shouldSkipLookupFocus(targetKey)) return;

      window.clearTimeout(lookupFocusTimers[targetKey]);
      lookupFocusTimers[targetKey] = window.setTimeout(() => {
        focusLookupInput(targetKey, options);
      }, options.delay ?? 0);
    };

    const initializeLookupTabFocus = () => {
      document.querySelectorAll("[data-lookup-tab-focus-target]").forEach((button) => {
        if (button.__lookupFocusBound === true) return;
        button.__lookupFocusBound = true;

        const targetKey = button.dataset.lookupTabFocusTarget;

        button.addEventListener("shown.bs.tab", () => {
          syncPageStepperVisibility(targetKey);
          syncLookupTabDescription(button);
          queueLookupInputFocus(targetKey, { delay: 0 });
        });

        button.addEventListener("click", () => {
          syncPageStepperVisibility(targetKey);
          syncLookupTabDescription(button);
          focusLookupInputNow(targetKey);
          queueLookupInputFocus(targetKey, { delay: 90 });
        });
      });

      const activeButton = document.querySelector("[data-lookup-tab-focus-target].active");
      if (activeButton) {
        syncPageStepperVisibility(activeButton.dataset.lookupTabFocusTarget);
        syncLookupTabDescription(activeButton);
        queueLookupInputFocus(activeButton.dataset.lookupTabFocusTarget, { preserveExistingFocus: true, delay: 0 });
      }
    };

    const initializeTransactionEntryModal = () => {
      const modalElement = transactionEntryModalElement();
      if (!modalElement) return;
      if (modalElement.dataset.transactionEntryModalBound === "true") return;

      modalElement.dataset.transactionEntryModalBound = "true";
      if (modalElement.dataset.autoOpenModal === "true" && modalElement.dataset.transactionEntryModalAutoOpened !== "true") {
        modalElement.dataset.transactionEntryModalAutoOpened = "true";
        bootstrap.Modal.getOrCreateInstance(modalElement).show();
      }
      modalElement.addEventListener("shown.bs.modal", () => {
        const activeButton = document.querySelector("[data-lookup-tab-focus-target].active");
        if (!activeButton) return;

        const currentStep = document
          .querySelector(`[data-transaction-page-stepper="${activeButton.dataset.lookupTabFocusTarget}"] [data-transaction-step-marker].is-current`)
          ?.dataset.transactionStepMarker;
        if (currentStep && currentStep !== "lookup") return;

        syncLookupTabDescription(activeButton);
        queueLookupInputFocus(activeButton.dataset.lookupTabFocusTarget, { preserveExistingFocus: false, delay: 0 });
      });
    };

    const initLookupTabs = () => {
      initializePhoneLookup();
      initializeVehicleLookup();
      initializeTransactionEntryModal();
      initializeLookupTabFocus();
    };

    document.addEventListener("turbo:load", initLookupTabs);
    document.addEventListener("DOMContentLoaded", initLookupTabs);
  })();
</script>
