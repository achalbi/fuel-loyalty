<% content_for :title, "Daily Settlement" %>
<% content_for :head do %>
  <%= javascript_include_tag "settlement_form", "data-turbo-track": "reload", defer: true %>
<% end %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Daily Settlement</h1>
  <%= link_to "My settlements", staff_settlements_path, class: "btn btn-outline-secondary btn-sm" %>
</div>

<%# Pump/date chooser — reloads a fresh draft (auto-popped readings + prices). %>
<%= form_with url: new_staff_settlement_path, method: :get, class: "row g-2 align-items-end mb-4" do |f| %>
  <div class="col-sm-4">
    <%= f.label :fuel_pump_id, "Pump", class: "form-label" %>
    <%= f.select :fuel_pump_id,
          options_for_select(FuelPump.active.ordered.map { |p| [p.display_name, p.id] }, @fuel_pump&.id),
          { include_blank: "My Pump" }, class: "form-select" %>
  </div>
  <div class="col-sm-4">
    <%= f.label :business_date, "Date", class: "form-label" %>
    <%= f.date_field :business_date, value: @settlement.business_date, class: "form-control" %>
  </div>
  <div class="col-sm-4">
    <%= f.submit "Load draft", class: "btn btn-outline-primary" %>
  </div>
<% end %>

<div class="card shadow-sm">
  <div class="card-body">
    <%= render "form" %>
  </div>
</div>
