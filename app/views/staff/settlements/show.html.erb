<% content_for :title, "Settlement" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3 mb-0"><%= @settlement.fuel_pump&.display_name %> · <%= @settlement.business_date %></h1>
    <span class="badge <%= settlement_status_badge_class(@settlement) %>"><%= @settlement.status.humanize %></span>
    <span class="text-muted small">FSM: <%= @settlement.fsm_name_snapshot %></span>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Back", staff_settlements_path, class: "btn btn-outline-secondary btn-sm" %>
    <% unless @settlement.locked? %>
      <%= link_to "Edit", edit_existing_settlement_path(@settlement), class: "btn btn-primary btn-sm" %>
    <% end %>
  </div>
</div>

<%# The same read-only sheet the admin console shows, so a query about a figure
    is a conversation about one document, not two renderings of it. %>
<%= render "shared/settlement_sheet", settlement: @settlement %>
