<% content_for :title, "Settlement" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3 mb-0"><%= @settlement.fuel_pump&.display_name %> · <%= @settlement.business_date %></h1>
    <span class="badge text-bg-<%= @settlement.reconciled? ? "success" : (@settlement.submitted? ? "primary" : "secondary") %>"><%= @settlement.status.humanize %></span>
    <span class="text-muted small">FSM: <%= @settlement.fsm_name_snapshot %></span>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Back", staff_settlements_path, class: "btn btn-outline-secondary btn-sm" %>
    <% unless @settlement.locked? %>
      <%= link_to "Edit", edit_staff_settlement_path(@settlement), class: "btn btn-primary btn-sm" %>
    <% end %>
  </div>
</div>

<div class="row g-3 mb-4">
  <% [["Fuel", @settlement.total_fuel_amount], ["Lubes", @settlement.total_lube_amount],
      ["Discounts", @settlement.total_discount_amount], ["Credit", @settlement.total_credit_amount],
      ["Final to settle", @settlement.final_amount_to_settle], ["Counted cash", @settlement.counted_cash_amount],
      ["Shortage", @settlement.shortage_amount]].each do |label, value| %>
    <div class="col-6 col-md-3">
      <div class="card h-100"><div class="card-body py-2">
        <div class="small text-muted"><%= label %></div>
        <div class="fw-semibold"><%= number_to_currency(value, unit: "₹") %></div>
      </div></div>
    </div>
  <% end %>
</div>

<h2 class="h5">Nozzle readings</h2>
<div class="table-responsive mb-4">
  <table class="table table-sm">
    <thead><tr><th>Nozzle</th><th>Fuel</th><th class="text-end">Open</th><th class="text-end">Close</th><th class="text-end">Testing</th><th class="text-end">Net L</th><th class="text-end">₹/L</th><th class="text-end">Amount</th></tr></thead>
    <tbody>
      <% @settlement.nozzle_readings.each do |r| %>
        <tr>
          <td><%= r.fuel_pump_nozzle&.display_name %></td>
          <td><%= r.fuel_type_code_snapshot.to_s.upcase %></td>
          <td class="text-end"><%= r.opening_reading %></td>
          <td class="text-end"><%= r.closing_reading %></td>
          <td class="text-end"><%= r.testing_litres %></td>
          <td class="text-end"><%= r.net_litres_sold %></td>
          <td class="text-end"><%= number_to_currency(r.unit_price, unit: "₹") %></td>
          <td class="text-end"><%= number_to_currency(r.amount, unit: "₹") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @settlement.lube_lines.any? %>
  <h2 class="h5">Lubricants</h2>
  <ul class="list-unstyled mb-4">
    <% @settlement.lube_lines.each do |l| %>
      <li><%= l.product_name_snapshot %> — <%= l.quantity %> × <%= number_to_currency(l.unit_price, unit: "₹") %> = <strong><%= number_to_currency(l.amount, unit: "₹") %></strong></li>
    <% end %>
  </ul>
<% end %>

<% if @settlement.discount_lines.any? %>
  <h2 class="h5">Discounts</h2>
  <ul class="list-unstyled mb-4">
    <% @settlement.discount_lines.each do |d| %>
      <li><%= d.transport_name.presence || d.driver_name.presence || "—" %>: <%= d.litres %> L → <%= number_to_currency(d.discount_amount, unit: "₹") %></li>
    <% end %>
  </ul>
<% end %>

<% if @settlement.credit_lines.any? %>
  <h2 class="h5">Credit lines</h2>
  <ul class="list-unstyled mb-4">
    <% @settlement.credit_lines.each do |c| %>
      <li><%= c.credit_type_label %> · <%= c.litres %> L · <%= number_to_currency(c.amount, unit: "₹") %> <span class="text-muted"><%= c.reference %></span></li>
    <% end %>
  </ul>
<% end %>

<% if @settlement.digital_receipts.any? %>
  <h2 class="h5">Digital receipts</h2>
  <ul class="list-unstyled mb-4">
    <% @settlement.digital_receipts.each do |r| %>
      <li><%= r.label %>: <%= number_to_currency(r.amount, unit: "₹") %></li>
    <% end %>
  </ul>
<% end %>

<% if @settlement.expense_lines.any? %>
  <h2 class="h5">Cash taken out</h2>
  <ul class="list-unstyled mb-4">
    <% @settlement.expense_lines.each do |e| %>
      <li><%= e.description %>: <%= number_to_currency(e.amount, unit: "₹") %></li>
    <% end %>
  </ul>
<% end %>

<div class="row g-4">
  <div class="col-md-4">
    <h2 class="h6">Cash count</h2>
    <table class="table table-sm"><tbody>
      <% @settlement.cash_denominations.each do |c| %>
        <tr><td>₹<%= c.denomination %></td><td class="text-end"><%= c.quantity %></td><td class="text-end"><%= number_to_currency(c.amount, unit: "₹") %></td></tr>
      <% end %>
    </tbody></table>
  </div>
  <div class="col-md-4">
    <h2 class="h6">Stock &amp; decantation</h2>
    <ul class="list-unstyled">
      <% @settlement.stock_receipts.each do |s| %><li><%= s.fuel_type_code.to_s.upcase %> received: <%= s.litres_received %> L</li><% end %>
      <% @settlement.decantations.each do |d| %><li><%= d.fuel_type_code.to_s.upcase %> <%= d.tank_label %>: <%= d.opening_kl %>→<%= d.closing_kl %> KL</li><% end %>
    </ul>
  </div>
  <div class="col-md-4">
    <h2 class="h6">Rate comparison</h2>
    <ul class="list-unstyled">
      <% @settlement.rate_comparisons.each do |r| %>
        <li><%= r.fuel_type_code.to_s.upcase %>: ours <%= number_with_precision(r.own_price, precision: 2) %> vs <%= r.competitor_name %> <%= number_with_precision(r.competitor_price, precision: 2) %></li>
      <% end %>
    </ul>
  </div>
</div>

<% if @settlement.notes.present? %><p class="mt-3 text-muted"><%= @settlement.notes %></p><% end %>
