<% content_for :title, "My Settlements" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Daily Settlements</h1>
  <%# Staff feedback item 3: recording a sheet is the FSM's job — an admin reads
      and corrects through the admin console (DailySettlementPolicy#new?). %>
  <% if current_user.admin? %>
    <%= link_to "Admin settlement console", admin_settlements_path, class: "btn btn-outline-primary" %>
  <% else %>
    <%= link_to "New settlement", new_staff_settlement_path, class: "btn btn-primary" %>
  <% end %>
</div>

<%= form_with url: staff_settlements_path, method: :get, class: "row g-2 align-items-end mb-3" do |f| %>
  <div class="col-sm-4">
    <%= f.label :business_date, "Date", class: "form-label" %>
    <%= f.date_field :business_date, value: @business_date, class: "form-control" %>
  </div>
  <div class="col-sm-4">
    <%= f.label :fuel_pump_id, "Pump", class: "form-label" %>
    <%= f.select :fuel_pump_id, options_for_select(@fuel_pumps.map { |p| [p.display_name, p.id] }, @fuel_pump&.id), { include_blank: "All pumps" }, class: "form-select" %>
  </div>
  <div class="col-sm-4"><%= f.submit "Filter", class: "btn btn-outline-secondary" %></div>
<% end %>

<% if @settlements.any? %>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead>
        <tr><th>Date</th><th>Pump</th><th>Recorded by</th><th>Status</th><th class="text-end">Fuel ₹</th><th class="text-end">Final ₹</th><th class="text-end">Shortage ₹</th><th></th></tr>
      </thead>
      <tbody>
        <% @settlements.each do |settlement| %>
          <tr>
            <td><%= settlement.business_date %></td>
            <td><%= settlement.fuel_pump&.display_name %></td>
            <td>
              <%= settlement.fsm_name_snapshot.presence || settlement.recorded_by&.display_name %>
              <% if settlement.admin_entered? %>
                <div class="text-muted small" data-entered-by>
                  entered by <%= settlement.entered_by&.display_name %><%= " on their behalf" if settlement.entered_on_behalf? %>
                </div>
              <% end %>
            </td>
            <td><span class="badge text-bg-<%= settlement.reconciled? ? "success" : (settlement.submitted? ? "primary" : "secondary") %>"><%= settlement.status.humanize %></span></td>
            <td class="text-end"><%= number_to_currency(settlement.total_fuel_amount, unit: "₹") %></td>
            <td class="text-end"><%= number_to_currency(settlement.final_amount_to_settle, unit: "₹") %></td>
            <td class="text-end <%= "text-danger" if settlement.shortage_amount.to_d.positive? %>"><%= number_to_currency(settlement.shortage_amount, unit: "₹") %></td>
            <td class="text-end">
              <%= link_to "View", staff_settlement_path(settlement), class: "btn btn-sm btn-outline-secondary" %>
              <% if !settlement.locked? && (current_user.admin? || settlement.recorded_by_id == current_user.id) %>
                <%= link_to "Edit", edit_staff_settlement_path(settlement), class: "btn btn-sm btn-outline-primary" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <% if current_user.admin? %>
    <p class="text-muted">No settlements yet. An FSM records the first one.</p>
  <% else %>
    <p class="text-muted">No settlements yet. <%= link_to "Record one", new_staff_settlement_path %>.</p>
  <% end %>
<% end %>
