<%# Shared pump + nozzle picker. Locals: form, user, assignable_fuel_pumps, assignable_fuel_pump_nozzles. %>
<% daily_pump_assignment = local_assigns[:daily_pump_assignment] %>
<% assignment_date = local_assigns[:assignment_date] %>
<% use_legacy_assignment = assignment_date.blank? || assignment_date == Date.current %>
<% selected_pump_id = (daily_pump_assignment&.fuel_pump_id || (user.fuel_pump_id if use_legacy_assignment)).to_s %>
<% selected_nozzle_ids = (daily_pump_assignment ? daily_pump_assignment.assigned_fuel_pump_nozzle_ids : (user.assigned_fuel_pump_nozzle_ids if use_legacy_assignment)).to_a.map(&:to_s) %>
<% nozzle_error_messages = user.errors[:assigned_fuel_pump_nozzle_ids].map do |message|
  case message
  when "must include at least one nozzle"
    "Select at least one nozzle for the chosen pump."
  when "must belong to the selected pump"
    "Select only nozzles from the chosen pump."
  when "must all be active"
    "Select only active nozzles for the chosen pump."
  else
    message
  end
end %>
<% pump_assignment_error_messages = user.errors.full_messages_for(:fuel_pump_id) +
  nozzle_error_messages +
  user.errors.full_messages_for(:base) %>
<% if pump_assignment_error_messages.any? %>
  <div class="alert alert-danger">
    <%= pump_assignment_error_messages.to_sentence %>
  </div>
<% end %>

<div>
  <%= form.label :fuel_pump_id, "Pump", class: "form-label" %>
  <%= form.select :fuel_pump_id,
    options_for_select(
      assignable_fuel_pumps.map do |fuel_pump|
        ["#{fuel_pump.display_name}#{fuel_pump.active? ? "" : " (Inactive)"}", fuel_pump.id]
      end,
      selected_pump_id
    ),
    { prompt: "Select a pump" },
    class: "form-select",
    data: { my_pump_select: true } %>
  <div class="form-text">Pick one pump for the selected day. Transactions recorded on that day use this assignment.</div>
</div>

<div class="my-pump-nozzle-picker">
  <div class="d-flex justify-content-between align-items-start gap-3">
    <div>
      <div class="form-label mb-1">Assigned Nozzles</div>
      <div class="form-text mt-0">Choose one or more nozzles from the selected pump. The transaction page will ask for one nozzle per transaction.</div>
    </div>
    <span class="badge rounded-pill text-bg-light border">Multiple allowed</span>
  </div>

  <%= hidden_field_tag "user[assigned_fuel_pump_nozzle_ids][]", "" %>

  <div class="alert alert-light border mb-0 <%= "d-none" if selected_pump_id.present? %>" data-my-pump-nozzle-empty-state>
    Select a pump to see its nozzles.
  </div>

  <% assignable_fuel_pumps.each do |fuel_pump| %>
    <% nozzles = assignable_fuel_pump_nozzles.fetch(fuel_pump, []) %>
    <% group_visible = selected_pump_id == fuel_pump.id.to_s %>
    <div class="<%= group_visible ? "" : "d-none" %>" data-my-pump-nozzle-group data-pump-id="<%= fuel_pump.id %>">
      <% if nozzles.any? %>
        <div class="my-pump-nozzle-grid">
          <% nozzles.each do |nozzle| %>
            <% input_id = "user_fuel_pump_nozzle_#{fuel_pump.id}_#{nozzle.id}" %>
            <div class="my-pump-nozzle-option" data-my-pump-nozzle-option>
              <%= check_box_tag "user[assigned_fuel_pump_nozzle_ids][]",
                nozzle.id,
                selected_nozzle_ids.include?(nozzle.id.to_s),
                id: input_id,
                class: "my-pump-nozzle-card__input",
                data: { my_pump_nozzle_input: true },
                disabled: !group_visible %>
              <%= label_tag input_id, class: "my-pump-nozzle-card" do %>
                <span class="my-pump-nozzle-card__copy">
                  <strong><%= nozzle.display_name %></strong>
                  <span><%= nozzle.fuel_type_name %></span>
                </span>
                <span class="my-pump-nozzle-card__meta">
                  <span class="badge rounded-pill text-bg-light border"><%= nozzle.fuel_type_name %></span>
                </span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="alert alert-warning mb-0">No active nozzles are available on <%= fuel_pump.display_name %> right now.</div>
      <% end %>
    </div>
  <% end %>
</div>
