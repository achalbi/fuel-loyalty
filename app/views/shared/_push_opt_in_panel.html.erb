<% panel_class = local_assigns.fetch(:panel_class, "mt-4") %>
<% enable_button_text = local_assigns.fetch(:enable_button_text, "Enable Notifications") %>
<% disable_button_text = local_assigns.fetch(:disable_button_text, "Disable Notifications") %>
<% enabled_button_text = local_assigns.fetch(:enabled_button_text, t("loyalty.push.enabled_button_text", default: "Notifications Enabled")) %>
<% off_button_text = local_assigns.fetch(:off_button_text, t("loyalty.push.off_button_text", default: "Notifications Off")) %>
<% app_disabled_message = local_assigns.fetch(:app_disabled_message, t("loyalty.push.app_disabled_message", default: "Notifications are turned off for this device in the app.")) %>
<% app_disabled_help = local_assigns.fetch(:app_disabled_help, t("loyalty.push.app_disabled_help", default: "Tap Enable Notifications to subscribe this device again.")) %>
<% enabled_message = local_assigns.fetch(:enabled_message, t("loyalty.push.enabled_message", default: "Push notifications are enabled on this device.")) %>
<% browser_disabled_message = local_assigns.fetch(:browser_disabled_message, t("loyalty.push.browser_disabled_message", default: "Notifications are currently turned off for this browser profile.")) %>
<% browser_disabled_help = local_assigns.fetch(:browser_disabled_help, t("loyalty.push.browser_disabled_help", default: "Turn notifications on in your browser or device settings, then reload this page.")) %>
<% permission_pending_message = local_assigns.fetch(:permission_pending_message, t("loyalty.push.permission_pending_message", default: "Notifications are not enabled on this device yet.")) %>
<% permission_pending_help = local_assigns.fetch(:permission_pending_help, t("loyalty.push.permission_pending_help", default: "Tap Enable Notifications whenever you're ready to allow alerts.")) %>
<% registration_error_help = local_assigns.fetch(:registration_error_help, t("loyalty.push.registration_error_help", default: "We could not complete push registration on this device. Please try again.")) %>
<% disable_error_help = local_assigns.fetch(:disable_error_help, t("loyalty.push.disable_error_help", default: "We could not turn off notifications on this device right now. Please try again.")) %>

<section
  class="install-app-panel <%= panel_class %>"
  data-push-opt-in-panel
  data-push-source="<%= source %>"
  data-push-enable-button-text="<%= enable_button_text %>"
  data-push-enabled-button-text="<%= enabled_button_text %>"
  data-push-off-button-text="<%= off_button_text %>"
  data-push-app-disabled-message="<%= app_disabled_message %>"
  data-push-app-disabled-help="<%= app_disabled_help %>"
  data-push-enabled-message="<%= enabled_message %>"
  data-push-browser-disabled-message="<%= browser_disabled_message %>"
  data-push-browser-disabled-help="<%= browser_disabled_help %>"
  data-push-permission-pending-message="<%= permission_pending_message %>"
  data-push-permission-pending-help="<%= permission_pending_help %>"
  data-push-registration-error-help="<%= registration_error_help %>"
  data-push-disable-error-help="<%= disable_error_help %>"
  aria-labelledby="<%= "#{source.parameterize}-push-title" %>">
  <div class="d-flex align-items-start gap-3">
    <div class="install-app-icon" aria-hidden="true">
      <i class="ti ti-bell-ringing"></i>
    </div>

    <div class="flex-grow-1">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
        <h2 id="<%= "#{source.parameterize}-push-title" %>" class="h6 mb-0"><%= title %></h2>
        <span class="badge text-bg-light border"><%= badge_label %></span>
      </div>

      <p class="small-muted mb-3" data-push-status><%= description %></p>

      <div class="d-grid gap-2">
        <button type="button" class="btn btn-outline-primary" data-push-button>
          <i class="ti ti-bell-plus me-1"></i>
          <span><%= enable_button_text %></span>
        </button>
        <button type="button" class="btn btn-outline-secondary d-none" data-push-disable-button>
          <i class="ti ti-bell-off me-1"></i>
          <span><%= disable_button_text %></span>
        </button>
        <p class="small-muted mb-0 d-none" data-push-help></p>
      </div>
    </div>
  </div>
</section>
