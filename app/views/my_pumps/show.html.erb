<% content_for :title, "My Pump" %>
<% selected_pump_id = current_user.fuel_pump_id.to_s %>
<% selected_nozzle_ids = current_user.assigned_fuel_pump_nozzle_ids.map(&:to_s) %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="mb-3">
          <h1 class="h3 mb-1">My Pump</h1>
          <p class="text-muted mb-0">Choose the pump you work on and the nozzles available to you. New transactions will use this pump automatically and show your assigned nozzles as radio options.</p>
        </div>

        <% if @assignable_fuel_pumps.empty? %>
          <div class="alert alert-warning mb-0">
            No pumps are available yet.
            <% if current_user.admin? %>
              <%= link_to "Add pumps", admin_fuel_pumps_path, class: "alert-link" %>
              to start using this feature.
            <% else %>
              Ask an admin to configure pumps first.
            <% end %>
          </div>
        <% else %>
          <%= form_with model: current_user, url: my_pump_path, method: :patch, class: "vstack gap-3", data: { my_pump_form: true } do |form| %>
            <% if current_user.errors.any? %>
              <div class="alert alert-danger">
                <%= current_user.errors.full_messages.to_sentence %>
              </div>
            <% end %>

            <div>
              <%= form.label :fuel_pump_id, "Pump", class: "form-label" %>
              <%= form.select :fuel_pump_id,
                options_for_select(
                  @assignable_fuel_pumps.map do |fuel_pump|
                    ["#{fuel_pump.display_name}#{fuel_pump.active? ? "" : " (Inactive)"}", fuel_pump.id]
                  end,
                  current_user.fuel_pump_id
                ),
                { prompt: "Select your pump" },
                class: "form-select",
                data: { my_pump_select: true } %>
              <div class="form-text">Pick one pump. This becomes the default pump for every new transaction you record.</div>
            </div>

            <div class="my-pump-nozzle-picker">
              <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                  <div class="form-label mb-1">Assigned Nozzles</div>
                  <div class="form-text mt-0">Choose one or more nozzles from your selected pump. The transaction page will ask you to pick one nozzle per transaction.</div>
                </div>
                <span class="badge rounded-pill text-bg-light border">Multiple allowed</span>
              </div>

              <%= hidden_field_tag "user[assigned_fuel_pump_nozzle_ids][]", "" %>

              <div class="alert alert-light border mb-0 <%= "d-none" if selected_pump_id.present? %>" data-my-pump-nozzle-empty-state>
                Select a pump to see its nozzles.
              </div>

              <% @assignable_fuel_pumps.each do |fuel_pump| %>
                <% nozzles = @assignable_fuel_pump_nozzles.fetch(fuel_pump, []) %>
                <% group_visible = selected_pump_id == fuel_pump.id.to_s %>
                <div class="<%= group_visible ? "" : "d-none" %>" data-my-pump-nozzle-group data-pump-id="<%= fuel_pump.id %>">
                  <% if nozzles.any? %>
                    <div class="my-pump-nozzle-grid">
                      <% nozzles.each do |nozzle| %>
                        <% input_id = "user_fuel_pump_nozzle_#{fuel_pump.id}_#{nozzle.id}" %>
                        <div class="my-pump-nozzle-option" data-my-pump-nozzle-option>
                          <%= check_box_tag "user[assigned_fuel_pump_nozzle_ids][]",
                            nozzle.id,
                            selected_nozzle_ids.include?(nozzle.id.to_s),
                            id: input_id,
                            class: "my-pump-nozzle-card__input",
                            data: { my_pump_nozzle_input: true },
                            disabled: !group_visible %>
                          <%= label_tag input_id, class: "my-pump-nozzle-card" do %>
                            <span class="my-pump-nozzle-card__copy">
                              <strong><%= nozzle.display_name %></strong>
                              <span><%= nozzle.fuel_type_name %></span>
                            </span>
                            <span class="my-pump-nozzle-card__meta">
                              <span class="badge rounded-pill text-bg-light border"><%= nozzle.fuel_type_name %></span>
                            </span>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  <% else %>
                    <div class="alert alert-warning mb-0">No active nozzles are available on <%= fuel_pump.display_name %> right now.</div>
                  <% end %>
                </div>
              <% end %>
            </div>

            <div class="d-flex gap-2">
              <%= form.submit "Save My Pump", class: "btn btn-primary" %>
              <%= link_to "Back", new_staff_transaction_path, class: "btn btn-outline-secondary" %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
