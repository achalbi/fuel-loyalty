<% content_for :title, "My Pump" %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="mb-3">
          <h1 class="h3 mb-1">My Pump</h1>
          <p class="text-muted mb-0">Choose the pump and nozzles you are working on today. Transactions you record today use this assignment.</p>
        </div>

        <% if @assignable_fuel_pumps.empty? %>
          <div class="alert alert-warning mb-0">
            No pumps are available yet.
            <% if current_user.admin? %>
              <%= link_to "Add pumps", admin_fuel_pumps_path, class: "alert-link" %>
              to start using this feature.
            <% else %>
              Ask an admin to configure pumps first.
            <% end %>
          </div>
        <% else %>
          <%= form_with model: current_user, url: my_pump_path, method: :patch, class: "vstack gap-3", data: { my_pump_form: true } do |form| %>
            <div>
              <span class="form-label d-block mb-1">Assignment Date</span>
              <p class="form-control-plaintext py-0 mb-0" data-my-pump-assignment-date>
                <%= l(@assignment_date, format: :long) %> <span class="text-muted">(today)</span>
              </p>
              <div class="form-text">
                My Pump always applies to today and does not change the default pump.
                <% if current_user.admin? %>
                  Plan another day from <%= link_to "Staff", admin_staff_members_path %>.
                <% end %>
              </div>
            </div>
            <%= render "shared/pump_assignment_fields",
              form: form,
              user: current_user,
              assignable_fuel_pumps: @assignable_fuel_pumps,
              assignable_fuel_pump_nozzles: @assignable_fuel_pump_nozzles,
              assignment_date: @assignment_date,
              assignment_mode: "override",
              daily_pump_assignment: @daily_pump_assignment %>

            <div class="d-flex gap-2">
              <%= form.submit "Save My Pump", class: "btn btn-primary" %>
              <%= link_to "Back", new_staff_transaction_path, class: "btn btn-outline-secondary" %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
