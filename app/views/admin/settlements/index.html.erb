<% content_for :title, "Settlements" %>

<h1 class="h3 mb-3">Daily Settlements</h1>

<%= form_with url: admin_settlements_path, method: :get, class: "row g-2 align-items-end mb-3" do |f| %>
  <div class="col-sm-3">
    <%= f.label :business_date, "Date", class: "form-label" %>
    <%= f.date_field :business_date, value: @business_date, class: "form-control" %>
  </div>
  <div class="col-sm-3">
    <%= f.label :fuel_pump_id, "Pump", class: "form-label" %>
    <%= f.select :fuel_pump_id, options_for_select(@fuel_pumps.map { |p| [p.display_name, p.id] }, @fuel_pump&.id), { include_blank: "All pumps" }, class: "form-select" %>
  </div>
  <div class="col-sm-3">
    <%= f.label :status, "Status", class: "form-label" %>
    <%= f.select :status, options_for_select(DailySettlement.statuses.keys.map { |s| [s.humanize, s] }, params[:status]), { include_blank: "Any" }, class: "form-select" %>
  </div>
  <div class="col-sm-3"><%= f.submit "Filter", class: "btn btn-outline-secondary" %></div>
<% end %>

<% if @cross_pump_totals %>
  <div class="card bg-body-tertiary mb-3">
    <div class="card-body row text-center g-2">
      <div class="col-12"><strong>Cross-pump totals — <%= @business_date %></strong></div>
      <% [["Fuel", :total_fuel_amount], ["Lubes", :total_lube_amount], ["Discounts", :total_discount_amount],
          ["Credit", :total_credit_amount], ["Final", :final_amount_to_settle], ["Cash", :counted_cash_amount],
          ["Shortage", :shortage_amount]].each do |label, key| %>
        <div class="col">
          <div class="small text-muted"><%= label %></div>
          <div class="fw-semibold"><%= number_to_currency(@cross_pump_totals[key], unit: "₹") %></div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<% if @settlements.any? %>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead><tr><th>Date</th><th>Pump</th><th>FSM</th><th>Status</th><th class="text-end">Fuel ₹</th><th class="text-end">Final ₹</th><th class="text-end">Shortage ₹</th><th></th></tr></thead>
      <tbody>
        <% @settlements.each do |s| %>
          <tr>
            <td><%= s.business_date %></td>
            <td><%= s.fuel_pump&.display_name %></td>
            <td><%= s.fsm_name_snapshot %></td>
            <td><span class="badge text-bg-<%= s.reconciled? ? "success" : (s.submitted? ? "primary" : "secondary") %>"><%= s.status.humanize %></span></td>
            <td class="text-end"><%= number_to_currency(s.total_fuel_amount, unit: "₹") %></td>
            <td class="text-end"><%= number_to_currency(s.final_amount_to_settle, unit: "₹") %></td>
            <td class="text-end <%= "text-danger" if s.shortage_amount.to_d.positive? %>"><%= number_to_currency(s.shortage_amount, unit: "₹") %></td>
            <td class="text-end"><%= link_to "Review", admin_settlement_path(s), class: "btn btn-sm btn-outline-secondary" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-muted">No settlements match.</p>
<% end %>
