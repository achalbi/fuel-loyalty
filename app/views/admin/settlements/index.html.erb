<% content_for :title, "Settlements" %>

<h1 class="h3 mb-3">Daily Settlements</h1>

<%= form_with url: admin_settlements_path, method: :get, class: "row g-2 align-items-end mb-3" do |f| %>
  <div class="col-sm-2">
    <%= f.label :business_date, "Date", class: "form-label" %>
    <%= f.date_field :business_date, value: @business_date, class: "form-control" %>
  </div>
  <div class="col-sm-3">
    <%= f.label :fuel_pump_id, "Pump", class: "form-label" %>
    <%= f.select :fuel_pump_id, options_for_select(@fuel_pumps.map { |p| [p.display_name, p.id] }, @fuel_pump&.id), { include_blank: "All pumps" }, class: "form-select" %>
  </div>
  <div class="col-sm-3">
    <%= f.label :user_id, "Staff (FSM)", class: "form-label" %>
    <%= f.select :user_id, options_for_select(@staff_members.map { |u| ["#{u.display_name}#{u.active? ? "" : " (Inactive)"}", u.id] }, @staff_member&.id), { include_blank: "All staff" }, class: "form-select" %>
  </div>
  <div class="col-sm-2">
    <%= f.label :status, "Status", class: "form-label" %>
    <%= f.select :status, options_for_select(DailySettlement.statuses.keys.map { |s| [s.humanize, s] }, params[:status]), { include_blank: "Any" }, class: "form-select" %>
  </div>
  <div class="col-sm-1"><%= f.submit "Filter", class: "btn btn-outline-secondary w-100" %></div>
<% end %>

<% if @cross_pump_totals %>
  <div class="card bg-body-tertiary mb-3">
    <div class="card-body row text-center g-2">
      <div class="col-12"><strong>Cross-pump totals — <%= @business_date %></strong></div>
      <% [["Fuel", :total_fuel_amount], ["Lubes", :total_lube_amount], ["Discounts", :total_discount_amount],
          ["Credit", :total_credit_amount], ["Final", :final_amount_to_settle], ["Cash", :counted_cash_amount],
          ["Shortage", :shortage_amount]].each do |label, key| %>
        <div class="col">
          <div class="small text-muted"><%= label %></div>
          <div class="fw-semibold"><%= number_to_currency(@cross_pump_totals[key], unit: "₹") %></div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<% if @per_user_totals.present? %>
  <div class="card mb-3">
    <div class="card-body">
      <h2 class="h6 mb-2">
        Per staff member<%= " — #{@business_date}" if @business_date %>
      </h2>
      <p class="text-muted small mb-2">Submitted and reconciled settlements only; drafts are still being entered.</p>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead>
            <tr>
              <th>Staff (FSM)</th><th>Pumps</th><th class="text-end">Settlements</th>
              <th class="text-end">Fuel ₹</th><th class="text-end">Discounts ₹</th>
              <th class="text-end">Final ₹</th><th class="text-end">Cash ₹</th><th class="text-end">Shortage ₹</th>
            </tr>
          </thead>
          <tbody>
            <% @per_user_totals.each do |row| %>
              <tr>
                <td>
                  <% if row[:user] %>
                    <%= link_to row[:name], admin_settlements_path(request.query_parameters.merge(user_id: row[:user].id)) %>
                  <% else %>
                    <%= row[:name] %>
                  <% end %>
                </td>
                <td class="text-muted small"><%= row[:pumps].join(", ").presence || "—" %></td>
                <td class="text-end">
                  <%= row[:count] %><% if row[:drafts].positive? %> <span class="text-muted small">+<%= row[:drafts] %> draft</span><% end %>
                </td>
                <td class="text-end"><%= number_to_currency(row[:totals][:total_fuel_amount], unit: "₹") %></td>
                <td class="text-end"><%= number_to_currency(row[:totals][:total_discount_amount], unit: "₹") %></td>
                <td class="text-end"><%= number_to_currency(row[:totals][:final_amount_to_settle], unit: "₹") %></td>
                <td class="text-end"><%= number_to_currency(row[:totals][:counted_cash_amount], unit: "₹") %></td>
                <td class="text-end <%= "text-danger" if row[:totals][:shortage_amount].positive? %>"><%= number_to_currency(row[:totals][:shortage_amount], unit: "₹") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% end %>

<% if @settlements.any? %>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead><tr><th>Date</th><th>Pump</th><th>FSM</th><th>Status</th><th class="text-end">Fuel ₹</th><th class="text-end">Final ₹</th><th class="text-end">Shortage ₹</th><th></th></tr></thead>
      <tbody>
        <% @settlements.each do |s| %>
          <tr>
            <td><%= s.business_date %></td>
            <td><%= s.fuel_pump&.display_name %></td>
            <td><%= s.recorded_by&.display_name.presence || s.fsm_name_snapshot %></td>
            <td><span class="badge text-bg-<%= s.reconciled? ? "success" : (s.submitted? ? "primary" : "secondary") %>"><%= s.status.humanize %></span></td>
            <td class="text-end"><%= number_to_currency(s.total_fuel_amount, unit: "₹") %></td>
            <td class="text-end"><%= number_to_currency(s.final_amount_to_settle, unit: "₹") %></td>
            <td class="text-end <%= "text-danger" if s.shortage_amount.to_d.positive? %>"><%= number_to_currency(s.shortage_amount, unit: "₹") %></td>
            <td class="text-end"><%= link_to "Review", admin_settlement_path(s), class: "btn btn-sm btn-outline-secondary" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-muted">No settlements match.</p>
<% end %>
