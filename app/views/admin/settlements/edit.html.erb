<% content_for :title, "Edit Settlement" %>
<% content_for :head do %>
  <%= javascript_include_tag "settlement_form", "data-turbo-track": "reload", defer: true %>
<% end %>

<%# Staff feedback item 3 — an admin corrects on the FSM's behalf; authorship
    never moves (Settlement::Persister keeps recorded_by) and the reason is
    mandatory. Say so on the form so it isn't mistaken for the admin's own entry. %>
<% fsm_name = @settlement.fsm_name_snapshot.presence || @settlement.recorded_by&.display_name || "the FSM on duty" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">
    Correct settlement <span class="badge text-bg-secondary align-middle"><%= @settlement.status.humanize %></span>
  </h1>
  <%= link_to "Back", admin_settlement_path(@settlement), class: "btn btn-outline-secondary btn-sm" %>
</div>

<div class="alert alert-warning">
  You are correcting <strong><%= fsm_name %></strong>'s settlement on their behalf.
  It stays recorded against them — you are logged only as the corrector — and the
  reason you give is mandatory and permanent in the audit trail.
  Editing a discount line linked to a customer visit re-derives that transaction's ₹
  and re-awards loyalty points.
</div>

<div class="card shadow-sm">
  <div class="card-body">
    <%= render "staff/settlements/form",
          admin_mode: true,
          form_url: admin_settlement_path(@settlement),
          form_method: :patch,
          cancel_path: admin_settlement_path(@settlement) %>
  </div>
</div>
