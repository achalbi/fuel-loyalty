<% content_for :title, "Settlement" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3 mb-0"><%= @settlement.fuel_pump&.display_name %> · <%= @settlement.business_date %></h1>
    <span class="badge <%= settlement_status_badge_class(@settlement) %>"><%= @settlement.status.humanize %></span>
    <span class="text-muted small">
      FSM: <%= @settlement.recorded_by&.display_name.presence || @settlement.fsm_name_snapshot %><% if @settlement.entered_on_behalf? %> · entered by <%= @settlement.entered_by.display_name %><% end %>
    </span>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Back", admin_settlements_path, class: "btn btn-outline-secondary btn-sm" %>
    <%= link_to "Edit", edit_admin_settlement_path(@settlement), class: "btn btn-primary btn-sm" %>
    <% unless @settlement.reconciled? %>
      <%= button_to "Reconcile", reconcile_admin_settlement_path(@settlement), method: :patch,
            class: "btn btn-success btn-sm", data: { turbo_confirm: "Reconcile and lock this settlement?" } %>
    <% end %>
  </div>
</div>

<%# The sheet exactly as the FSM entered it — same sections, same order, same
    columns, read-only. Reviewing a shift means checking what was written down,
    which a rolled-up summary cannot support. %>
<%= render "shared/settlement_sheet", settlement: @settlement %>

<h2 class="h5 mt-4">Audit trail</h2>
<% if @changes.any? %>
  <div class="vstack gap-2 mb-4">
    <% @changes.each do |change| %>
      <div class="card">
        <div class="card-body py-2">
          <div class="d-flex justify-content-between">
            <strong><%= change.change_reason %></strong>
            <span class="text-muted small">
              <%= change.changed_by&.display_name %><% if change.on_behalf_of %> on behalf of <%= change.on_behalf_of.display_name %><% end %>
              · <%= change.created_at&.strftime("%d %b %Y %H:%M") %>
            </span>
          </div>
          <% if change.recomputed_points %><span class="badge text-bg-warning">Points recomputed</span><% end %>
          <ul class="small mb-0 mt-1">
            <% change.field_diffs.each do |field, (old_value, new_value)| %>
              <% if old_value.is_a?(Array) || new_value.is_a?(Array) %>
                <li><%= field.humanize %> lines changed</li>
              <% else %>
                <li><%= field.humanize %>: <span class="text-muted"><%= old_value.presence || "—" %></span> → <strong><%= new_value.presence || "—" %></strong></li>
              <% end %>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-muted">No edits recorded.</p>
<% end %>
