<% content_for :title, "Products" %>

<div class="row g-4">
  <div class="col-lg-4">
    <div class="card shadow-sm h-100">
      <div class="card-body">
        <h1 class="h3 mb-3">Products</h1>
        <p class="text-muted">The priced catalog of fuels and lubricants sold at the outlet. The selling price is used to value fuel and lube sales in Daily Settlement.</p>

        <%= render "form", product: @product, submit_label: "Add Product", autofocus: true %>
      </div>
    </div>
  </div>

  <div class="col-lg-8">
    <div class="card shadow-sm h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
          <div>
            <h2 class="h4 mb-1">Catalog</h2>
            <p class="text-muted mb-0">Edit prices, hide products from new selections, or remove unused ones.</p>
          </div>
          <span class="badge rounded-pill text-bg-light border"><%= pluralize(@products.count, "product") %></span>
        </div>

        <% if @products.any? %>
          <div class="reward-rates-form vstack gap-3">
            <% @products.each do |product| %>
              <div class="reward-rate-row">
                <div class="reward-rate-copy">
                  <div class="reward-rate-title"><%= product.display_name %></div>
                  <p class="reward-rate-meta mb-0">
                    Category: <strong><%= product.category.humanize %></strong>.
                    <% if product.fuel? %>Prices <strong><%= FuelType.label_for(product.fuel_type_code) %></strong> nozzles.<% end %>
                    MRP: <strong>Rs. <%= product.mrp %></strong>. Selling: <strong>Rs. <%= product.selling_price %></strong>.
                    <% if product.batch.present? %>Batch: <code><%= product.batch %></code>.<% end %>
                    <%= product.active? ? "Shown in app." : "Hidden from new selections." %>
                  </p>
                </div>

                <div class="reward-rate-field d-flex flex-column align-items-end gap-2">
                  <span class="badge rounded-pill <%= product.active? ? "text-bg-success" : "text-bg-secondary" %>"><%= product.active? ? "Active" : "Inactive" %></span>

                  <div class="d-flex gap-2">
                    <%= link_to "Edit", edit_admin_product_path(product), class: "btn btn-outline-secondary btn-sm" %>
                    <%= button_to "Delete",
                      admin_product_path(product),
                      method: :delete,
                      class: "btn btn-outline-danger btn-sm",
                      form: {
                        class: "d-inline-block",
                        data: { confirm_modal: true, confirm_message: "Remove #{product.display_name}?" }
                      } %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="alert alert-light border mb-0">No products have been added yet.</div>
        <% end %>
      </div>
    </div>
  </div>
</div>
