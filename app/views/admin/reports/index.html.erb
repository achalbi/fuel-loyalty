<% content_for :title, "Reports" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Reports</h1>
  <%= link_to "Download CSV", admin_reports_path(request.query_parameters.merge(format: :csv)), class: "btn btn-outline-primary" %>
</div>

<%= form_with url: admin_reports_path, method: :get, class: "row g-2 align-items-end mb-3" do |f| %>
  <div class="col-6 col-md-3">
    <%= f.label :dimension, "By", class: "form-label" %>
    <%= f.select :dimension, options_for_select(@dimensions.map { |d| [d.humanize, d] }, @report.dimension), {}, class: "form-select" %>
  </div>
  <div class="col-6 col-md-3">
    <%= f.label :grain, "Grain", class: "form-label" %>
    <%= f.select :grain, options_for_select(@grains.map { |g| [g.humanize, g] }, @report.grain), {}, class: "form-select" %>
  </div>
  <div class="col-6 col-md-3">
    <%= f.label :start_date, "From", class: "form-label" %>
    <%= f.date_field :start_date, value: (params[:start_date].presence || @report.date_range.begin), class: "form-control" %>
  </div>
  <div class="col-6 col-md-3">
    <%= f.label :end_date, "To", class: "form-label" %>
    <%= f.date_field :end_date, value: (params[:end_date].presence || @report.date_range.end), class: "form-control" %>
  </div>

  <%# Free-text lookups. The values echoed back are the NORMALIZED ones the query %>
  <%# actually ran with — a plate typed "ka 01 aa" really did search "KA01AA". %>
  <div class="col-6 col-md-3">
    <%= f.label :transporter, "Transporter", class: "form-label" %>
    <%= f.text_field :transporter, value: @report.transporter, class: "form-control", placeholder: "Any transporter", autocomplete: "off" %>
  </div>
  <div class="col-6 col-md-3">
    <%= f.label :driver_name, "Driver name", class: "form-label" %>
    <%= f.text_field :driver_name, value: @report.driver_name, class: "form-control", placeholder: "Any driver", autocomplete: "off" %>
  </div>
  <div class="col-6 col-md-3">
    <%= f.label :driver_phone, "Driver mobile", class: "form-label" %>
    <%= f.telephone_field :driver_phone, value: @report.driver_phone, class: "form-control", placeholder: "Any mobile", autocomplete: "off" %>
  </div>
  <div class="col-6 col-md-3">
    <%= f.label :vehicle_number, "Vehicle number", class: "form-label" %>
    <%= f.text_field :vehicle_number, value: @report.vehicle_number, class: "form-control", placeholder: "Any vehicle", autocomplete: "off" %>
  </div>

  <div class="col-6 col-md-3">
    <%= f.label :fuel_type, "Fuel", class: "form-label" %>
    <%= f.select :fuel_type, options_for_select(@fuel_types.map { |t| [t.name, t.code] }, params[:fuel_type]), { include_blank: "All" }, class: "form-select" %>
  </div>
  <div class="col-6 col-md-3">
    <%= f.label :fuel_pump_id, "Pump", class: "form-label" %>
    <%= f.select :fuel_pump_id, options_for_select(@fuel_pumps.map { |p| [p.display_name, p.id] }, params[:fuel_pump_id]), { include_blank: "All" }, class: "form-select" %>
  </div>
  <div class="col-6 col-md-3">
    <%= f.label :customer_id, "Customer", class: "form-label" %>
    <%= f.select :customer_id, options_for_select(@customers.map { |c| ["#{c.display_name} · #{c.phone_number}", c.id] }, params[:customer_id]), { include_blank: "All" }, class: "form-select" %>
  </div>
  <div class="col-6 col-md-3 d-flex gap-2">
    <%= f.submit "Run", class: "btn btn-primary flex-grow-1" %>
    <%# Only offered once something is narrowing the report, and it keeps the %>
    <%# grouping/grain/date range so "clear" means "clear the lookups", not "start over". %>
    <% if @report.filtered? %>
      <%= link_to "Clear",
        admin_reports_path(dimension: @report.dimension, grain: @report.grain,
                           start_date: @report.date_range.begin, end_date: @report.date_range.end),
        class: "btn btn-outline-secondary" %>
    <% end %>
  </div>
<% end %>

<p class="text-muted small">
  ₹ amounts are derived from litres × catalog selling price (litres are the source of truth).
  "Reward ₹" is the cash value of points redemptions; "Gifts" counts physical campaign gifts handed over
  (attributable per customer only, so it reads 0 on the other groupings). Litres/discount come from per-visit captures.
  Transporter, driver, mobile and vehicle match on any part of the value and combine with each other.
  <% unless @report.reward_value_configured? %>
    <span class="text-warning-emphasis">Reward ₹ shows "—" because no cash value per point is configured — set one in reward settings for redemptions to carry a ₹ value.</span>
  <% end %>
</p>

<% if @report.rows.any? %>
  <div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
      <thead>
        <tr>
          <th><%= @report.dimension.humanize %></th><th>Period</th>
          <th class="text-end">Litres</th><th class="text-end">Amount ₹</th>
          <th class="text-end">Discount ₹</th><th class="text-end">Reward ₹</th>
          <th class="text-end">Gifts</th><th class="text-end">Visits</th>
        </tr>
      </thead>
      <tbody>
        <% @report.rows.each do |row| %>
          <tr>
            <td><%= row.label %></td>
            <td><%= row.period %></td>
            <td class="text-end"><%= number_with_precision(row.litres, precision: 3, strip_insignificant_zeros: true) %></td>
            <td class="text-end"><%= row.amount ? number_to_currency(row.amount, unit: "₹") : content_tag(:span, "—", class: "text-muted") %></td>
            <td class="text-end"><%= number_to_currency(row.discount, unit: "₹") %></td>
            <%# "—" when no cash-per-point rate is set: those redemptions stored a NULL ₹, so a 0 here would be a lie. %>
            <td class="text-end"><%= (@report.reward_value_configured? || !row.gifts.zero?) ? number_to_currency(row.gifts, unit: "₹") : content_tag(:span, "—", class: "text-muted") %></td>
            <td class="text-end"><%= row.gift_count %></td>
            <td class="text-end"><%= row.visits %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr class="fw-semibold border-top">
          <td colspan="2">Total</td>
          <td class="text-end"><%= number_with_precision(@report.totals[:litres], precision: 3, strip_insignificant_zeros: true) %></td>
          <td class="text-end"><%= number_to_currency(@report.totals[:amount], unit: "₹") %></td>
          <td class="text-end"><%= number_to_currency(@report.totals[:discount], unit: "₹") %></td>
          <td class="text-end"><%= (@report.reward_value_configured? || !@report.totals[:gifts].zero?) ? number_to_currency(@report.totals[:gifts], unit: "₹") : content_tag(:span, "—", class: "text-muted") %></td>
          <td class="text-end"><%= @report.totals[:gift_count] %></td>
          <td class="text-end"><%= @report.totals[:visits] %></td>
        </tr>
      </tfoot>
    </table>
  </div>
<% else %>
  <% if @report.filtered? %>
    <p class="text-muted">No captures match these filters. The lookups combine — a row has to match every one you filled in — so try clearing one, or widening the date range.</p>
  <% else %>
    <p class="text-muted">No captures in this range. Try a wider date range or a different dimension.</p>
  <% end %>
<% end %>
