<% content_for :title, "Campaigns" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Campaigns</h1>
  <%= link_to "New campaign", new_admin_campaign_path, class: "btn btn-primary" %>
</div>

<% if @campaigns.any? %>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead><tr><th>Name</th><th>Reward</th><th>Threshold</th><th>Audience</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% @campaigns.each do |campaign| %>
          <tr>
            <td><%= link_to campaign.name, admin_campaign_path(campaign) %></td>
            <td><%= campaign.offer_headline %></td>
            <td>
              <%= "₹#{campaign.min_purchase_amount.to_i}" if campaign.min_purchase_amount %>
              <%= "#{campaign.min_purchase_litres} L" if campaign.min_purchase_litres %>
              <span class="text-muted small">/ <%= campaign.period.humanize.downcase %></span>
            </td>
            <td><%= campaign.target_type.humanize %><%= " · #{campaign.target_customer_type.humanize}" if campaign.target_customer_type.present? %></td>
            <td><span class="badge text-bg-<%= campaign.active? ? "success" : (campaign.paused? ? "warning" : "secondary") %>"><%= campaign.status.humanize %></span></td>
            <td class="text-end"><%= link_to "Manage", admin_campaign_path(campaign), class: "btn btn-sm btn-outline-secondary" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-muted">No campaigns yet. <%= link_to "Create one", new_admin_campaign_path %>.</p>
<% end %>
