<% content_for :title, "Reset Data" %>
<% confirmation_phrase = Admin::DataReset::CONFIRMATION_PHRASE %>
<% armed_entities = @reset.entities %>
<% total_armed = armed_entities.sum { |entity| @counts[entity.key].to_i } %>
<% customer_phone = params[:customer_phone].to_s.gsub(/\D/, "") %>

<div class="row justify-content-center">
  <div class="col-xxl-9">
    <div class="d-flex align-items-center gap-2 mb-3">
      <i class="ti ti-alert-triangle text-danger fs-3"></i>
      <div>
        <h1 class="h3 mb-0">Reset Transaction Data</h1>
        <p class="text-muted mb-0 small">Permanently deletes the operational records you tick below. There is no undo.</p>
      </div>
    </div>

    <% if @error.present? %>
      <div class="alert alert-danger border-0 shadow-sm"><%= @error %></div>
    <% end %>
    <% if @customer_lookup_error.present? && @error != @customer_lookup_error %>
      <div class="alert alert-warning border-0 shadow-sm"><%= @customer_lookup_error %></div>
    <% end %>

    <%= form_with url: admin_data_reset_path, method: :post, class: "vstack gap-3 mb-3" do %>
      <%= hidden_field_tag :mode, "preview" %>

      <div class="card shadow-sm">
        <div class="card-header bg-transparent">
          <h2 class="h6 mb-0">1. What to delete</h2>
        </div>
        <div class="card-body vstack gap-3">
          <% Admin::DataReset::ENTITIES.each do |entity| %>
            <% count = @counts[entity.key].to_i %>
            <div class="form-check">
              <%= check_box_tag "entities[]", entity.key, @reset.selected?(entity.key),
                    id: "entity_#{entity.key}", class: "form-check-input" %>
              <label class="form-check-label w-100" for="entity_<%= entity.key %>">
                <span class="d-flex flex-wrap align-items-center gap-2">
                  <strong><%= entity.label %></strong>
                  <% if @reset.applicable?(entity) %>
                    <span class="badge text-bg-light border">
                      <%= number_with_delimiter(count) %> <%= "row".pluralize(count) %> in scope
                    </span>
                  <% else %>
                    <span class="badge text-bg-secondary">Skipped — a customer filter is applied</span>
                  <% end %>
                </span>
                <span class="d-block text-muted small"><%= entity.description %></span>
              </label>
            </div>
          <% end %>

          <% if @reset.selected?("transactions") %>
            <% linked = @reset.linked_points_ledger_count %>
            <div class="alert alert-info border-0 mb-0 small">
              <i class="ti ti-link me-1"></i>
              <%= number_with_delimiter(linked) %> points ledger <%= "entry".pluralize(linked) %>
              attached to the in-scope transactions will be deleted as well — the database will not let a
              transaction go without them.
            </div>
          <% end %>
        </div>
      </div>

      <div class="card shadow-sm">
        <div class="card-header bg-transparent">
          <h2 class="h6 mb-0">2. How much to delete</h2>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-sm-4">
              <label class="form-label" for="start_date">From date</label>
              <%= date_field_tag :start_date, @reset.start_date&.iso8601, id: "start_date", class: "form-control" %>
            </div>
            <div class="col-sm-4">
              <label class="form-label" for="end_date">To date</label>
              <%= date_field_tag :end_date, @reset.end_date&.iso8601, id: "end_date", class: "form-control" %>
            </div>
            <div class="col-sm-4">
              <label class="form-label" for="customer_phone">Customer phone number</label>
              <%= text_field_tag :customer_phone, customer_phone.presence, id: "customer_phone",
                    class: "form-control", inputmode: "numeric", maxlength: 10, placeholder: "All customers" %>
            </div>
          </div>

          <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
            <button type="submit" class="btn btn-outline-secondary">
              <i class="ti ti-refresh me-1"></i>Preview counts
            </button>
            <span class="text-muted small">
              Leave the dates blank to cover all time, and the phone number blank to cover every customer.
              <% if @reset.customer.present? %>
                Currently scoped to
                <strong><%= @reset.customer.name.presence || "Customer ##{@reset.customer.id}" %></strong>
                (<%= @reset.customer.phone_number %>).
              <% end %>
            </span>
          </div>
        </div>
      </div>
    <% end %>

    <%= form_with url: admin_data_reset_path, method: :post, class: "card shadow-sm border-danger",
          data: { confirm_modal: true, confirm_message: "This permanently deletes the previewed data. There is no undo." } do %>
      <%= hidden_field_tag :mode, "execute" %>
      <% armed_entities.each { |entity| %><%= hidden_field_tag "entities[]", entity.key, id: nil %><% } %>
      <%= hidden_field_tag :start_date, @reset.start_date&.iso8601, id: nil %>
      <%= hidden_field_tag :end_date, @reset.end_date&.iso8601, id: nil %>
      <%= hidden_field_tag :customer_phone, customer_phone, id: nil %>

      <div class="card-header bg-transparent">
        <h2 class="h6 mb-0">3. Confirm and reset</h2>
      </div>
      <div class="card-body">
        <p class="mb-3">
          <% if armed_entities.any? %>
            This deletes <strong><%= number_with_delimiter(total_armed) %></strong>
            <%= "row".pluralize(total_armed) %> across
            <strong><%= armed_entities.map(&:label).to_sentence %></strong><%= @reset.scoped? ? ", within the scope above" : ", for all time and all customers" %>.
          <% else %>
            Tick at least one type of data above and press <strong>Preview counts</strong> first.
          <% end %>
          <span class="d-block text-muted small mt-1">
            Only what is shown here gets deleted. If you changed anything above, press
            <strong>Preview counts</strong> to refresh this summary first.
          </span>
        </p>

        <div class="row g-2 align-items-end">
          <div class="col-sm-5">
            <label class="form-label" for="confirmation">
              Type <code><%= confirmation_phrase %></code> to run the reset
            </label>
            <%= text_field_tag :confirmation, nil, id: "confirmation", class: "form-control",
                  autocomplete: "off" %>
          </div>
          <div class="col-sm-7">
            <button type="submit" class="btn btn-danger" <%= "disabled" if armed_entities.empty? %>>
              <i class="ti ti-trash me-1"></i>Reset data
            </button>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
