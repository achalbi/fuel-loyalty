<% modal_context = local_assigns[:context].to_s == "modal" %>

<% form_markup = capture do %>
  <%= form_with model: user, url: form_url, method: form_method, html: { multipart: true }, class: "vstack gap-3" do |form| %>
    <% if user.errors.any? %>
      <div class="alert alert-danger">
        <%= user.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div>
      <%= form.label :name, class: "form-label" %>
      <%= form.text_field :name, class: "form-control", required: true, autocomplete: "name", placeholder: "Full name" %>
    </div>

    <div>
      <%= form.label :username, "Username (Login)", class: "form-label" %>
      <%= form.text_field :username, class: "form-control", required: true, autocomplete: "username" %>
      <div class="form-text">This is the login username shown on the sign-in page.</div>
    </div>

    <div>
      <%= form.label :phone_number, "Mobile Number", class: "form-label" %>
      <div class="input-group admin-users-form__phone-group">
        <span class="input-group-text phone-prefix">+91</span>
        <%= form.telephone_field :phone_number, class: "form-control", required: true, placeholder: "10 digit mobile number", inputmode: "numeric", autocomplete: "tel-national", maxlength: 10, pattern: "\\d{10}", title: "Enter a 10 digit mobile number", data: { phone_number_field: true } %>
      </div>
    </div>

    <div>
      <%= form.label :email, "Email (Optional)", class: "form-label" %>
      <%= form.email_field :email, value: user.explicit_email, class: "form-control", placeholder: "name@example.com", autocomplete: "email" %>
    </div>

    <fieldset class="border rounded p-3">
      <legend class="form-label float-none w-auto px-1 mb-0">Identity / KYC <span class="text-muted small">(optional)</span></legend>
      <div class="mb-2">
        <%= form.label :address, class: "form-label small mb-1" %>
        <%= form.text_area :address, rows: 2, class: "form-control", placeholder: "Postal address" %>
      </div>
      <div class="mb-2">
        <%= form.label :aadhaar_number, "Aadhaar Number", class: "form-label small mb-1" %>
        <%= form.text_field :aadhaar_number, value: nil, class: "form-control", inputmode: "numeric",
              maxlength: 12, pattern: "\\d{12}", autocomplete: "off",
              placeholder: (user.aadhaar_present? ? "Current: #{user.masked_aadhaar_number} — leave blank to keep" : "12 digits") %>
      </div>
      <div class="row g-2">
        <div class="col-sm-6">
          <%= form.label :profile_photo, "Profile Photo", class: "form-label small mb-1" %>
          <%= form.file_field :profile_photo, accept: "image/*", class: "form-control" %>
          <% if user.profile_photo.attached? %>
            <%= image_tag url_for(user.profile_photo.variant(resize_to_limit: [80, 80])), class: "mt-2 rounded", alt: "Current photo" %>
          <% end %>
        </div>
        <div class="col-sm-6">
          <%= form.label :id_card_photo, "ID-card Photo", class: "form-label small mb-1" %>
          <%= form.file_field :id_card_photo, accept: "image/*", class: "form-control" %>
          <% if user.persisted? && user.id_card_present? %>
            <%= link_to "View current ID card", id_card_photo_admin_user_path(user), target: "_blank", rel: "noopener", class: "small d-inline-block mt-2" %>
          <% end %>
        </div>
      </div>
    </fieldset>

    <div>
      <%= form.label :role, class: "form-label" %>
      <%= form.select :role, User.roles.keys.map { |role| [role.titleize, role] }, {}, class: "form-select" %>
    </div>

    <div>
      <%= form.label :active, "Access Status", class: "form-label" %>
      <%= form.select :active,
        options_for_select([["Active", true], ["Inactive", false]], user.active?),
        {},
        class: "form-select" %>
      <div class="form-text">Inactive users stay in history but cannot sign in until reactivated.</div>
    </div>

    <div>
      <%= form.label :password, class: "form-label" %>
      <%= form.password_field :password, class: "form-control", autocomplete: form_method == :post ? "new-password" : "off" %>
      <% if form_method != :post %>
        <div class="form-text">Leave blank to keep the existing password.</div>
      <% end %>
    </div>

    <div>
      <%= form.label :password_confirmation, class: "form-label" %>
      <%= form.password_field :password_confirmation, class: "form-control", autocomplete: form_method == :post ? "new-password" : "off" %>
    </div>

    <div class="d-flex gap-2">
      <%= form.submit submit_label, class: "btn btn-primary" %>
      <% if modal_context %>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
      <% else %>
        <%= link_to "Cancel", admin_users_path, class: "btn btn-outline-secondary" %>
      <% end %>
    </div>
  <% end %>
<% end %>

<% if modal_context %>
  <div class="admin-users-form admin-users-form--modal">
    <%= form_markup %>
  </div>
<% else %>
  <div class="row justify-content-center">
    <div class="col-md-7">
      <div class="card shadow-sm">
        <div class="card-body">
          <h1 class="h3 mb-2"><%= title %></h1>
          <p class="text-muted mb-3"><%= description %></p>
          <%= form_markup %>
        </div>
      </div>
    </div>
  </div>
<% end %>
