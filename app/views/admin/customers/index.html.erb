<% content_for :title, "Customers" %>

<div class="mb-4 page-header admin-customers-header">
  <div class="page-intro admin-customers-header__intro mb-0">
    <div class="admin-customers-header__topline">
      <h1>Customers</h1>
      <div class="page-actions">
        <%= button_tag "+ New",
          type: "button",
          class: "admin-customers-create-action",
          data: { bs_toggle: "modal", bs_target: "#addCustomerModal" },
          aria: { label: "New Customer" },
          title: "New Customer" %>
      </div>
    </div>
    <p>Browse enrolled loyalty customers, their vehicles, and their current point balance.</p>
  </div>
</div>

<div class="card shadow-sm admin-transactions-filter admin-customers-filter mb-4">
  <div class="card-body">
    <% period_params = { preset: @current_preset, start_date: @current_start_date, end_date: @current_end_date }.compact_blank %>
    <%= form_with url: admin_customers_path, method: :get, local: true, class: "admin-customers-filter__form" do |form| %>
      <%= hidden_field_tag :status, @current_status %>
      <% period_params.each do |key, value| %>
        <%= hidden_field_tag key, value %>
      <% end %>

      <div class="admin-transactions-filter__group admin-customers-filter__search">
        <%= form.label :q, "Search", class: "admin-transactions-filter__label" %>
        <%= form.text_field :q,
          value: @query,
          class: "form-control admin-customers-filter__input",
          placeholder: "Search by name, phone, or vehicle" %>
      </div>

      <div class="admin-transactions-filter__group admin-customers-filter__quick-filter">
        <span class="admin-transactions-filter__label">Quick Filter</span>
        <div class="dashboard-filter-chips">
          <%= link_to "All",
            admin_customers_path({ q: @query.presence, status: "all", type: @current_customer_type }.compact_blank.merge(period_params)),
            class: "dashboard-filter-chip #{'is-active' if @current_status == 'all'}" %>
          <%= link_to "Active",
            admin_customers_path({ q: @query.presence, status: "active", type: @current_customer_type }.compact_blank.merge(period_params)),
            class: "dashboard-filter-chip #{'is-active' if @current_status == 'active'}" %>
          <%= link_to "Inactive",
            admin_customers_path({ q: @query.presence, status: "inactive", type: @current_customer_type }.compact_blank.merge(period_params)),
            class: "dashboard-filter-chip #{'is-active' if @current_status == 'inactive'}" %>
        </div>
      </div>

      <div class="admin-transactions-filter__group admin-customers-filter__quick-filter">
        <span class="admin-transactions-filter__label">Customer Type</span>
        <div class="dashboard-filter-chips">
          <% customer_type_filters = [[nil, "All"], ["drive_in", "Drive-in"], ["otp", "OTP / Fleet"], ["credit", "Credit"]] %>
          <% customer_type_filters.each do |type, label| %>
            <%= link_to label,
              admin_customers_path({ q: @query.presence, status: @current_status, type: type }.compact_blank.merge(period_params)),
              class: "dashboard-filter-chip #{'is-active' if @current_customer_type == type}" %>
          <% end %>
        </div>
      </div>

      <div class="admin-customers-filter__actions">
        <%= form.submit "Search", class: "btn btn-primary" %>
        <% if @query.present? || @current_status != "all" || @current_customer_type.present? || @period_range.present? %>
          <%= link_to "Clear", admin_customers_path, class: "btn btn-outline-secondary" %>
        <% end %>
      </div>
    <% end %>

    <% if @period_range.present? %>
      <div class="alert alert-info d-flex justify-content-between align-items-center mt-3 mb-0" data-customers-period-banner>
        <span>Showing customers active between <strong><%= @period_range.begin.to_date.strftime("%d %b %Y") %></strong> and <strong><%= @period_range.end.to_date.strftime("%d %b %Y") %></strong>.</span>
        <%= link_to "Clear period", admin_customers_path({
          q: @query.presence,
          status: (@current_status unless @current_status == "all"),
          type: @current_customer_type
        }.compact_blank), class: "alert-link" %>
      </div>
    <% end %>
  </div>
</div>

<div class="card shadow-sm admin-customers-card">
  <div class="card-body">
    <% if @customers.any? %>
      <div class="customer-details-vehicle-list admin-customers-list">
        <% @customers.each do |customer| %>
          <% display_name = customer.display_name.to_s.titleize %>
          <% vehicle_summary = customer.vehicles.map(&:vehicle_number).presence&.join(", ") || "No vehicles on file" %>
          <div class="customer-details-vehicle-row admin-customer-item">
            <div class="customer-details-vehicle-row__main admin-customer-item__main">
              <div class="admin-customer-item__heading">
                <span class="admin-customer-item__name"><%= display_name %></span>
                <span class="admin-customer-item__status <%= customer.active? ? "is-active" : "is-inactive" %>"><%= customer.status_label %></span>
              </div>
              <div class="admin-customer-item__details">
                <span class="admin-customer-item__phone">+91 <%= customer.phone_number %></span>
                <span class="admin-customer-item__vehicles"><%= vehicle_summary %></span>
              </div>
            </div>
            <div class="admin-customer-item__side">
              <span class="admin-customer-item__points"><%= customer.total_points %> pts</span>
              <%= link_to admin_customer_path(customer),
                class: "customer-details-history-preview-action admin-customer-item__view",
                aria: { label: "View #{display_name}" },
                title: "View customer" do %>
                <i class="ti ti-eye" aria-hidden="true"></i>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="admin-customers-empty mb-0">
        <%= (@query.present? || @current_status != "all" || @current_customer_type.present? || @period_range.present?) ? "No customers matched the current filters." : "No customers available yet." %>
      </p>
    <% end %>
  </div>
</div>

<div
  class="modal fade customer-details-modal admin-customers-modal"
  id="addCustomerModal"
  tabindex="-1"
  aria-labelledby="addCustomerModalLabel"
  aria-hidden="true"
  data-auto-open-modal="<%= @customer.errors.any? %>">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content confirm-modal-content customer-details-modal__content admin-customers-modal__content">
      <div class="modal-header border-0 pb-0">
        <div>
          <h2 class="modal-title h5 mb-1" id="addCustomerModalLabel">Add Customer</h2>
          <p class="text-muted mb-0 small">Create a new customer and add the first vehicle right away.</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body pt-3">
        <%= render "customers/form",
          customer: @customer,
          form_url: admin_customers_path,
          form_method: :post,
          include_vehicle_fields: true,
          submit_label: "Save Customer",
          title: "Add Customer",
          context: "modal" %>
      </div>
    </div>
  </div>
</div>
