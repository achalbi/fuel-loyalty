<% content_for :title, "Edit Pump" %>

<div class="row justify-content-center">
  <div class="col-lg-7">
    <div class="card shadow-sm">
      <div class="card-body">
        <h1 class="h3 mb-3"><%= @fuel_pump.display_name %></h1>
        <p class="text-muted">Update pump availability and configure the nozzles attached to this unit.</p>

        <%= render "form",
          fuel_pump: @fuel_pump,
          submit_label: "Save Pump",
          cancel_path: admin_fuel_pumps_path %>
      </div>
    </div>
  </div>
</div>
