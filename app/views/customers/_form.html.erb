<% modal_context = local_assigns[:context].to_s == "modal" %>
<% show_back_cancel_button = local_assigns[:show_back_cancel_button] %>
<% cancel_fallback_path = local_assigns[:cancel_fallback_path] %>
<% hidden_fields = local_assigns[:hidden_fields] || {} %>
<% lock_vehicle_fields = local_assigns.fetch(:lock_vehicle_fields, false) %>
<% selected_vehicle_number = params.dig(customer.model_name.param_key, :vehicle_number).presence || customer.vehicle_number.presence %>
<% selected_fuel_type = params.dig(customer.model_name.param_key, :fuel_type).presence %>
<% selected_vehicle_kind = params.dig(customer.model_name.param_key, :vehicle_kind).presence %>
<% selected_commercial_company_name = params.dig(customer.model_name.param_key, :commercial_company_name).presence %>
<% selected_commercial_contact_name = params.dig(customer.model_name.param_key, :commercial_contact_name).presence %>
<% selected_commercial_contact_phone_number = params.dig(customer.model_name.param_key, :commercial_contact_phone_number).presence %>
<% selected_commercial_address = params.dig(customer.model_name.param_key, :commercial_address).presence %>
<% selected_commercial_notes = params.dig(customer.model_name.param_key, :commercial_notes).presence %>
<% fuel_type_options = FuelType.active_options %>
<% vehicle_type_options = VehicleType.active_options %>
<% vehicle_type_icons = VehicleType.icon_map_for(vehicle_type_options.map(&:last)) %>
<% commercial_vehicle_selected = Vehicle.commercial_vehicle_kind?(selected_vehicle_kind) %>

<% form_markup = capture do %>
  <%= form_with model: customer,
    url: form_url,
    method: form_method,
    class: "vstack gap-3",
    data: { commercial_vehicle_form: true, commercial_vehicle_kinds: Vehicle::COMMERCIAL_VEHICLE_KINDS.join(",") } do |form| %>
    <% if customer.errors.any? %>
      <div class="alert alert-danger">
        <%= customer.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div>
      <%= form.label :name, "Name (optional)", class: "form-label" %>
      <%= form.text_field :name, class: "form-control", autocomplete: "name" %>
    </div>

    <div>
      <%= form.label :phone_number, class: "form-label" %>
      <div class="input-group customer-form__phone-group">
        <span class="input-group-text phone-prefix">+91</span>
        <%= form.telephone_field :phone_number, class: "form-control", required: true, placeholder: "10 digit phone number", inputmode: "numeric", autocomplete: "tel-national", maxlength: 10, pattern: "\\d{10}", title: "Enter a 10 digit phone number", data: { phone_number_field: true } %>
      </div>
    </div>

    <div>
      <%= form.label :customer_type, "Account Type", class: "form-label" %>
      <%= form.select :customer_type,
        options_for_select(Customer.customer_type_options, customer.customer_type),
        {}, class: "form-select" %>
      <div class="form-text">How this customer is billed / treated — drives dashboard segmentation.</div>
    </div>

    <div>
      <span class="form-label d-block mb-1">Marketing opt-ins</span>
      <div class="form-check form-check-inline">
        <%= form.check_box :whatsapp_opt_in, class: "form-check-input" %>
        <%= form.label :whatsapp_opt_in, "WhatsApp offers", class: "form-check-label" %>
      </div>
      <div class="form-check form-check-inline">
        <%= form.check_box :sms_opt_in, class: "form-check-input" %>
        <%= form.label :sms_opt_in, "SMS offers", class: "form-check-label" %>
      </div>
      <div class="form-text">Set only with the customer's consent — campaigns reach these channels only when opted in.</div>
    </div>

    <div class="row g-3">
      <div class="col">
        <%= form.label :transport_name, "Transport / Fleet Name", class: "form-label" %>
        <%= form.text_field :transport_name, class: "form-control", placeholder: "Optional" %>
      </div>
      <div class="col">
        <%= form.label :approx_vehicle_count, "Approx. Vehicles", class: "form-label" %>
        <%= form.number_field :approx_vehicle_count, class: "form-control", min: 0, placeholder: "Optional" %>
      </div>
    </div>

    <div>
      <%= form.label :info_note, "Add a note", class: "form-label" %>
      <%# Item 13 — each save appends a dated entry; nothing is overwritten. %>
      <%= form.text_area :info_note, value: nil, class: "form-control", rows: 3,
        placeholder: "What was said, or the follow-up planned" %>
      <div class="form-text">Saved as a new dated entry — earlier notes are kept.</div>
    </div>

    <% if customer.persisted? || local_assigns[:include_contacts] %>
      <% blank_contact_rows = [2 - customer.customer_contacts.count(&:new_record?), 0].max %>
      <% blank_contact_rows.times { customer.customer_contacts.build } %>
      <fieldset class="customer-form__contacts">
        <legend class="form-label mb-1">Contacts</legend>
        <p class="form-text mt-0 mb-2">Drivers, supervisors, owners or managers linked to this account. Leave a row blank to skip it; mark <em>Contacted</em> once you've reached them.</p>
        <%= form.fields_for :customer_contacts do |contact_form| %>
          <div class="customer-form__contact-row border rounded p-2 mb-2">
            <div class="row g-2">
              <div class="col-12 col-sm-4">
                <%= contact_form.label :role, "Role", class: "form-label small mb-1" %>
                <%= contact_form.select :role,
                  options_for_select(CustomerContact::ROLES.map { |role| [role.humanize, role] }, contact_form.object.role),
                  { include_blank: "—" }, class: "form-select form-select-sm" %>
              </div>
              <div class="col-12 col-sm-4">
                <%= contact_form.label :name, "Name", class: "form-label small mb-1" %>
                <%= contact_form.text_field :name, class: "form-control form-control-sm", placeholder: "Optional" %>
              </div>
              <div class="col-12 col-sm-4">
                <%= contact_form.label :phone_number, "Phone", class: "form-label small mb-1" %>
                <%= contact_form.telephone_field :phone_number, class: "form-control form-control-sm", inputmode: "numeric", maxlength: 10, pattern: "\\d{10}", placeholder: "Optional" %>
              </div>
            </div>
            <div class="d-flex align-items-center gap-3 mt-2">
              <div class="form-check mb-0">
                <%= contact_form.check_box :contacted, class: "form-check-input" %>
                <%= contact_form.label :contacted, "Contacted", class: "form-check-label small" %>
              </div>
              <% if contact_form.object.persisted? %>
                <div class="form-check mb-0">
                  <%= contact_form.check_box :_destroy,
                    class: "form-check-input",
                    data: {
                      confirm_removal: true,
                      confirm_message: "Remove this contact when the customer is saved?"
                    } %>
                  <%= contact_form.label :_destroy, "Remove", class: "form-check-label small text-danger" %>
                </div>
              <% end %>
            </div>
            <%= contact_form.text_area :notes,
              class: "form-control form-control-sm mt-2",
              rows: 2,
              placeholder: "Notes about this contact or conversation" %>
          </div>
        <% end %>
      </fieldset>
    <% end %>

    <% if include_vehicle_fields %>
      <div class="<%= "d-none" if lock_vehicle_fields %>" data-registration-editable-group="vehicle_number">
        <%= form.label :vehicle_number, "Initial Vehicle Number", class: "form-label" %>
        <%= form.text_field :vehicle_number, class: "form-control", required: false, disabled: lock_vehicle_fields, data: { registration_vehicle_number_field: true } %>
        <div class="form-text">Optional. You can add one or more vehicles after the customer record is created.</div>
      </div>

      <div class="<%= "d-none" if lock_vehicle_fields %>" data-registration-editable-group="fuel_type">
        <%= render "shared/fuel_type_radio_group",
          legend: "Fuel Type",
          input_name: "customer[fuel_type]",
          options: fuel_type_options,
          selected_value: selected_fuel_type,
          field_id_prefix: "customer_fuel_type",
          errors: customer.errors[:fuel_type],
          hint: "Only active fuel types appear here.",
          required: false,
          disabled: lock_vehicle_fields %>
      </div>

      <div class="<%= "d-none" if lock_vehicle_fields %> customer-form__vehicle-kind-block" data-registration-editable-group="vehicle_kind">
        <%= render "shared/fuel_type_radio_group",
          legend: "Vehicle Type",
          input_name: "customer[vehicle_kind]",
          options: vehicle_type_options,
          icons_by_value: vehicle_type_icons,
          selected_value: selected_vehicle_kind,
          field_id_prefix: "customer_vehicle_kind",
          errors: customer.errors[:vehicle_kind],
          hint: "Only active vehicle types appear here.",
          empty_message: "No active vehicle types are available right now.",
          required: false,
          disabled: lock_vehicle_fields %>
      </div>

      <div class="<%= "d-none" if lock_vehicle_fields %>" data-registration-editable-group="commercial_registration">
        <%= render "shared/commercial_vehicle_fields",
          scope_name: customer.model_name.param_key,
          field_id_prefix: "customer",
          values: {
            commercial_company_name: selected_commercial_company_name,
            commercial_contact_name: selected_commercial_contact_name,
            commercial_contact_phone_number: selected_commercial_contact_phone_number,
            commercial_address: selected_commercial_address,
            commercial_notes: selected_commercial_notes
          },
          errors: customer.errors,
          visible: commercial_vehicle_selected %>
      </div>

      <% if lock_vehicle_fields && selected_vehicle_number.present? %>
        <%= hidden_field_tag "customer[vehicle_number]", selected_vehicle_number, data: { registration_locked_mirror: "customer[vehicle_number]" } %>
      <% end %>

      <% if lock_vehicle_fields && selected_fuel_type.present? %>
        <%= hidden_field_tag "customer[fuel_type]", selected_fuel_type, data: { registration_locked_mirror: "customer[fuel_type]" } %>
      <% end %>

      <% if lock_vehicle_fields && selected_vehicle_kind.present? %>
        <%= hidden_field_tag "customer[vehicle_kind]", selected_vehicle_kind, data: { registration_locked_mirror: "customer[vehicle_kind]" } %>
      <% end %>
    <% end %>

    <% hidden_fields.each do |field_name, field_value| %>
      <%= hidden_field_tag field_name, field_value %>
    <% end %>

    <div class="d-flex gap-2">
      <%= form.submit submit_label, class: "btn btn-primary" %>
      <% if modal_context %>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
      <% elsif show_back_cancel_button %>
        <button
          type="button"
          class="btn btn-outline-secondary"
          data-cancel-back-button="true"
          data-fallback-path="<%= cancel_fallback_path %>"
          onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = this.dataset.fallbackPath; }">Cancel</button>
      <% end %>
    </div>
  <% end %>
<% end %>

<% if modal_context %>
  <div class="admin-customers-form admin-customers-form--modal">
    <%= form_markup %>
  </div>
<% else %>
  <div class="row justify-content-center">
    <div class="col-md-7">
      <div class="card shadow-sm">
        <div class="card-body">
          <h1 class="h3 mb-3"><%= title %></h1>
          <%= form_markup %>
        </div>
      </div>
    </div>
  </div>
<% end %>
